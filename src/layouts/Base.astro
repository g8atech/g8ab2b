---
import '../styles/global.css';
import '../styles/blocks.css';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import GoogleBadge from '../components/blocks/GoogleBadge.astro';
import ConsentHead from '../components/ConsentHead.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import logoWhite from '../assets/logo-g8a-bianco.png';
import logoColor from '../assets/logo-g8a.png';
import { SITE, SEDI, GRUPPO, waLink, telLink } from '../data/site';

interface Props { title: string; description: string; jsonLd?: object[]; mbar?: { tel: string; wa: string } }
const { title, description, jsonLd = [], mbar } = Astro.props;
// Il Noleggio Assistito raccoglie i servizi in un menu a tendina, per tenere la barra corta.
const NOLEGGIO = [
  { href: '/noleggio-computer', t: 'Computer', d: 'PC, All in One e notebook G8A', icon: 'pc' },
  { href: '/noleggio-stampanti', t: 'Stampanti', d: 'Multifunzione con toner inclusi', icon: 'printer' },
  { href: '/noleggio-backup', t: 'Backup e NAS', d: 'I dati al sicuro, anche fuori sede', icon: 'server' },
  { href: '/rmm', t: 'Monitoraggio RMM', d: 'Controlliamo i tuoi PC di continuo', icon: 'activity' },
];
const NAV = [
  { href: '/testimonianze-casistudio', t: 'Casi studio' },
  { href: '/assistenza-business', t: 'Contatti' },
];
const here = Astro.url.pathname.replace(/(\.html|\/)$/, '');
const inNoleggio = NOLEGGIO.some((n) => n.href === here);
const cleanPath = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath, SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  legalName: SITE.company,
  vatID: `IT${SITE.vat}`,
  url: SITE.url,
  logo: `${SITE.url}/logo.png`,
  email: SITE.email,
  telephone: '+39 ' + SITE.phone,
  slogan: SITE.tagline,
  areaServed: ['Provincia di Varese', 'Città metropolitana di Milano', 'Provincia di Lecco'],
  address: { '@type': 'PostalAddress', streetAddress: 'Via Caronno Varesino 33', postalCode: '21048', addressLocality: 'Solbiate Arno', addressRegion: 'VA', addressCountry: 'IT' },
  subOrganization: GRUPPO.map((g) => ({ '@type': 'Organization', name: g.name, url: g.url })),
};
// I negozi con pagina propria hanno i loro dati strutturati nella pagina; qui le altre sedi.
const stores = SEDI.filter((s) => !s.operativa && !s.negozio).map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: `${SITE.name} ${s.city}`,
  parentOrganization: { '@id': `${SITE.url}/#organization` },
  telephone: '+39 ' + SITE.phone,
  address: { '@type': 'PostalAddress', streetAddress: s.address, postalCode: s.cap, addressLocality: s.city, addressRegion: s.province, addressCountry: 'IT' },
}));
const schemas = [organization, ...stores, ...jsonLd];
// Google Tag Manager: si attiva solo se su Vercel è impostata PUBLIC_GTM_ID (es. GTM-M5FDVQDW).
const gtm = import.meta.env.PUBLIC_GTM_ID;
const live = import.meta.env.PUBLIC_SITE_LIVE === 'true';
// Verifica proprietà: Google Search Console e Bing Webmaster Tools (solo il codice "content" del meta tag).
const gsc = import.meta.env.PUBLIC_GSC_VERIFICATION;
const bing = import.meta.env.PUBLIC_BING_VERIFICATION;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    {!live && <meta name="robots" content="noindex, nofollow" />}
    {gsc && <meta name="google-site-verification" content={gsc} />}
    {bing && <meta name="msvalidate.01" content={bing} />}
    <ConsentHead />
    {gtm && <script is:inline define:vars={{ gtm }}>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtm);</script>}
    <link rel="icon" href="/logo-icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/logo-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/og-g8a.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="G8A Technology, Noleggio Assistito per aziende" />
    <meta name="twitter:card" content="summary_large_image" />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    {gtm && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtm}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>}
    <a class="skip" href="#contenuto">Vai al contenuto</a>

    <div class="topbar">
      <div class="wrap topbar__row">
        <GoogleBadge size="sm" dark />
        <span class="topbar__right"><a href={SITE.rmmLogin}>Login G8A RMM</a><span aria-hidden="true">·</span><a href={SITE.ticket}>Apri un ticket</a></span>
      </div>
    </div>

    <header class="hdr">
      <div class="wrap hdr__row">
        <a href="/" class="hdr__logo" aria-label="G8A Technology, home"><Image src={logoColor} alt="G8A Technology" height={52} densities={[1, 2]} loading="eager" /></a>
        <nav aria-label="Menu principale" class="hdr__nav" id="menu">
          <div class="dd" data-dd>
            <button class="dd__btn" type="button" aria-expanded="false" aria-controls="dd-noleggio" data-current={inNoleggio ? '' : undefined}>Noleggio Assistito<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" /></svg></button>
            <div class="dd__panel" id="dd-noleggio">
              <a class="dd__intro" href="/#include"><strong>Il Noleggio Assistito</strong><span>Tutta l'informatica in un canone. Come funziona →</span></a>
              {NOLEGGIO.map((n) => (
                <a class="dd__item" href={n.href} aria-current={here === n.href ? 'page' : undefined}>
                  <span class="dd__ic"><Icon name={n.icon} size={20} stroke="#fff" width={2} /></span>
                  <span><strong>{n.t}</strong><small>{n.d}</small></span>
                </a>
              ))}
            </div>
          </div>
          {NAV.map((n) => <a href={n.href} aria-current={here === n.href ? 'page' : undefined}>{n.t}</a>)}
          <a class="hdr__only-m" href={SITE.rmmLogin}>Login G8A RMM</a>
          <a class="hdr__only-m" href={SITE.ticket}>Apri un ticket</a>
        </nav>
        <div class="hdr__cta">
          <a class="btn btn--line btn--sm hdr__tel" href={telLink}><Icon name="phone" />{SITE.phone}</a>
          <a class="btn btn--wa btn--sm" href={waLink()}><Icon name="wa" />WhatsApp</a>
          <button class="hdr__burger" type="button" aria-label="Apri il menu" aria-expanded="false" aria-controls="menu"><Icon name="menu" size={22} /></button>
        </div>
      </div>
    </header>

    <main id="contenuto">
      <slot />
    </main>

    <footer class="ftr">
      <div class="wrap ftr__grid">
        <div>
          <Image src={logoWhite} alt="G8A Technology" height={50} densities={[1, 2]} />
          <p class="ftr__claim">{SITE.tagline}</p>
        </div>
        <div>
          <p class="ftr__h">Servizi</p>
          <ul>
            <li><a href="/noleggio-computer">Noleggio computer</a></li>
            <li><a href="/noleggio-stampanti">Noleggio stampanti</a></li>
            <li><a href="/noleggio-backup">Backup e NAS</a></li>
            <li><a href="/rmm">Monitoraggio RMM</a></li>
            <li><a href="/testimonianze-casistudio">Casi studio</a></li>
          </ul>
          <p class="ftr__h" style="margin-top:1.2rem">Negozi</p>
          <ul>{SEDI.filter((s) => s.negozio).map((s) => <li><a href={`/${s.negozio!.slug}`}>{s.city}</a></li>)}</ul>
        </div>
        <div>
          <p class="ftr__h">Il gruppo</p>
          <ul>{GRUPPO.map((g) => <li><a href={g.url}>{g.name}</a></li>)}</ul>
        </div>
        <div>
          <p class="ftr__h">Contatti</p>
          <ul>
            <li><a href={telLink}>{SITE.phone}</a></li>
            <li><a href={waLink()}>WhatsApp</a></li>
            <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            <li><a href={SITE.rmmLogin}>Login G8A RMM</a></li>
            <li><a href={SITE.ticket}>Apri un ticket</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap ftr__legal">
        <span>© {new Date().getFullYear()} {SITE.company} · P.IVA {SITE.vat} · REA {SITE.rea} · Cap. soc. {SITE.capital} · Sede legale {SITE.legalAddress}</span>
        <span class="ftr__pol"><a href="/privacy-policy">Privacy policy</a><a href="/cookie-policy">Cookie policy</a><button type="button" data-cookie-prefs>Preferenze cookie</button></span>
      </div>
    </footer>

    <ConsentBanner />

    <nav class="mbar" aria-label="Contatti rapidi">
      <a class="btn btn--red" href={mbar?.tel ?? telLink}><Icon name="phone" />Chiama</a>
      <a class="btn btn--wa" href={mbar?.wa ?? waLink()}><Icon name="wa" />WhatsApp</a>
    </nav>

    <script>
      // Comparsa al passaggio: gli elementi con data-reveal entrano quando arrivano a schermo.
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Conversioni: ogni clic su telefono, WhatsApp o email finisce nel dataLayer (per GA4 e Google Ads via GTM).
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest('a');
        if (!a) return;
        const h = a.getAttribute('href') || '';
        const canale = h.startsWith('tel:') ? 'telefono' : h.includes('wa.me/') ? 'whatsapp' : h.startsWith('mailto:') ? 'email' : null;
        if (!canale) return;
        const w = window as unknown as { dataLayer?: object[] };
        (w.dataLayer = w.dataLayer || []).push({ event: 'contatto', canale, pagina: location.pathname, testo: a.textContent?.trim() });
      });

      // Menu a tendina su schermi stretti.
      const burger = document.querySelector('.hdr__burger');
      const menu = document.getElementById('menu');
      burger?.addEventListener('click', () => {
        const open = menu!.classList.toggle('is-open');
        burger.setAttribute('aria-expanded', String(open));
        burger.setAttribute('aria-label', open ? 'Chiudi il menu' : 'Apri il menu');
      });

      // Menu Noleggio Assistito: si apre al passaggio del mouse (CSS) e al clic o da tastiera (qui).
      document.querySelectorAll('[data-dd]').forEach((dd) => {
        const btn = dd.querySelector('.dd__btn')!;
        const set = (open: boolean) => { dd.classList.toggle('is-open', open); btn.setAttribute('aria-expanded', String(open)); };
        btn.addEventListener('click', () => set(!dd.classList.contains('is-open')));
        dd.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Escape') { set(false); (btn as HTMLElement).focus(); } });
        document.addEventListener('click', (e) => { if (!dd.contains(e.target as Node)) set(false); });
        dd.addEventListener('focusout', (e) => { if (!dd.contains((e as FocusEvent).relatedTarget as Node)) set(false); });
      });

      // Barra rossa di avanzamento sotto l'intestazione.
      const hdr = document.querySelector('.hdr') as HTMLElement | null;
      const prog = () => { const h = document.documentElement; hdr?.style.setProperty('--progress', String(h.scrollTop / Math.max(1, h.scrollHeight - h.clientHeight))); };
      addEventListener('scroll', prog, { passive: true }); prog();

      // Robot dell'apertura che seguono leggermente il mouse.
      const tilt = document.querySelector('[data-tilt]') as HTMLElement | null;
      if (tilt && matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
        const target = tilt.querySelector('.robots') as HTMLElement;
        tilt.addEventListener('pointermove', (e) => {
          const r = tilt.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
          target.style.setProperty('--mx', `${x * 14}px`); target.style.setProperty('--my', `${y * 10}px`);
          target.style.setProperty('--ry', `${x * 8}deg`); target.style.setProperty('--rx', `${-y * 6}deg`);
        });
        tilt.addEventListener('pointerleave', () => ['--mx', '--my', '--ry', '--rx'].forEach((k) => target.style.removeProperty(k)));
      }

      // Numeri che contano fino al valore quando entrano a schermo.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const co = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          co.unobserve(e.target);
          const el = e.target as HTMLElement;
          const to = Number(el.dataset.count);
          if (reduce || !to) continue;
          const pre = el.dataset.pre ?? '', post = el.dataset.post ?? '';
          const t0 = performance.now(), dur = 1400;
          const step = (t: number) => {
            const k = Math.min(1, (t - t0) / dur), v = Math.round(to * (1 - Math.pow(1 - k, 3)));
            el.textContent = pre + v + post;
            if (k < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }
      }, { threshold: 0.5 });
      document.querySelectorAll('[data-count]').forEach((el) => co.observe(el));
    </script>
  </body>
</html>

<style>
  .topbar { background: var(--ink); color: #c3c6cd; font-size: 0.85rem; }
  .topbar__row { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem 1.5rem; padding-block: 0.35rem; }
  .topbar__right { display: flex; gap: 0.6rem; }
  .topbar__right a { color: #fff; font-weight: 700; text-decoration: none; }
  .topbar__right a:hover { color: #ff6b6b; }
  @media (max-width: 640px) { .topbar__right { display: none; } .topbar__row { justify-content: center; } }
  .hdr { position: sticky; top: 0; z-index: 30; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .hdr::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--grad); transform-origin: left; transform: scaleX(var(--progress, 0)); }
  .hdr__row { display: flex; align-items: center; justify-content: space-between; gap: 1rem 2rem; padding-block: 0.6rem; }
  .hdr__logo :global(img) { width: auto; height: 52px; }
  .hdr__nav { display: flex; gap: 1.5rem; font-weight: 700; font-size: 0.95rem; }
  .hdr__nav a[aria-current='page'] { color: var(--red); }
  .hdr__only-m, .hdr__burger { display: none; }
  .hdr__nav a { color: var(--ink); text-decoration: none; }
  .hdr__nav a:hover { color: var(--red); }
  .hdr__cta { display: flex; gap: 0.6rem; }
  .hdr__nav { align-items: center; }
  .dd { position: relative; }
  .dd__btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0; border: 0; background: none; font: inherit; font-weight: 700; color: var(--ink); cursor: pointer; }
  .dd__btn[data-current] { color: var(--red); }
  .dd__btn svg { transition: transform 0.2s; }
  .dd__btn:hover { color: var(--red); }
  .dd__panel { position: absolute; top: calc(100% + 0.9rem); left: 50%; width: 25rem; display: grid; gap: 0.25rem; padding: 0.6rem; border-radius: 18px; background: #fff; border: 1px solid var(--line); box-shadow: 0 30px 60px rgba(11, 11, 13, 0.18); opacity: 0; visibility: hidden; transform: translate(-50%, 8px); transition: opacity 0.18s, transform 0.18s, visibility 0.18s; }
  .dd__panel::before { content: ''; position: absolute; left: 0; right: 0; top: -1rem; height: 1rem; }
  .dd.is-open .dd__panel { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
  .dd.is-open .dd__btn svg { transform: rotate(180deg); }
  @media (hover: hover) and (min-width: 1001px) { .dd:hover .dd__panel { opacity: 1; visibility: visible; transform: translate(-50%, 0); } .dd:hover .dd__btn svg { transform: rotate(180deg); } }
  .dd__intro { display: grid; gap: 0.15rem; padding: 0.9rem 1rem; border-radius: 12px; background: var(--ink); color: #fff !important; text-decoration: none; }
  .dd__intro span { font-size: 0.85rem; font-weight: 600; color: #ff8a8a; }
  .dd__item { display: flex; gap: 0.8rem; align-items: center; padding: 0.65rem 0.8rem; border-radius: 12px; text-decoration: none; }
  .dd__item:hover, .dd__item[aria-current='page'] { background: var(--paper); }
  .dd__item strong { display: block; color: var(--ink); }
  .dd__item small { display: block; font-size: 0.85rem; font-weight: 500; color: var(--muted); }
  .dd__ic { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 10px; background: var(--grad); flex: none; }
  @media (max-width: 1000px) {
    .hdr__burger { display: inline-grid; place-items: center; width: 2.9rem; height: 2.9rem; border-radius: 8px; border: 2px solid var(--ink); background: #fff; color: var(--ink); cursor: pointer; }
    .hdr__nav { display: none; position: absolute; left: 0; right: 0; top: 100%; flex-direction: column; gap: 0; padding: 0.5rem var(--gutter) 1rem; background: #fff; border-bottom: 1px solid var(--line); box-shadow: 0 20px 40px rgba(11, 11, 13, 0.12); }
    .hdr__nav.is-open { display: flex; }
    .hdr__nav { align-items: stretch; }
    .hdr__nav > a { padding: 0.85rem 0; border-bottom: 1px solid var(--line); font-size: 1.05rem; }
    .hdr__only-m { display: block; }
    .dd__btn { display: none; }
    .dd__panel { position: static; width: auto; opacity: 1; visibility: visible; transform: none; box-shadow: none; border: 0; padding: 0.5rem 0; border-bottom: 1px solid var(--line); border-radius: 0; grid-template-columns: 1fr 1fr; }
    .dd__intro { grid-column: 1 / -1; }
    .dd__panel::before { display: none; }
  }
  @media (max-width: 560px) { .dd__panel { grid-template-columns: 1fr; } .dd__item small { display: none; } }
  @media (max-width: 640px) { .hdr__tel { display: none; } .hdr__logo :global(img) { height: 42px; } }

  .ftr { background: var(--ink); color: #8e929c; font-size: 0.95rem; padding-top: 3rem; border-top: 4px solid; border-image: var(--grad) 1; }
  .ftr__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 2rem; }
  .ftr__grid :global(img) { width: auto; height: 50px; }
  .ftr__claim { margin-top: 0.9rem; max-width: 22rem; }
  .ftr__h { color: #fff; font-weight: 700; margin-bottom: 0.6rem; }
  .ftr ul { list-style: none; margin: 0; padding: 0; line-height: 2; }
  .ftr a { color: #c3c6cd; text-decoration: none; }
  .ftr a:hover { color: #fff; }
  .ftr__legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.6rem 1.5rem; margin-top: 2.5rem; padding-block: 1.25rem 2rem; border-top: 1px solid rgba(255,255,255,0.1); font-size: 0.8rem; }
  .ftr__pol { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; }
  .ftr__pol button { padding: 0; border: 0; background: none; font: inherit; color: #c3c6cd; cursor: pointer; }
  .ftr__pol a:hover, .ftr__pol button:hover { color: #fff; }

  .mbar { display: none; }
  @media (max-width: 640px) {
    .mbar { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; padding: 0.7rem 0.9rem calc(0.7rem + env(safe-area-inset-bottom)); background: rgba(255, 255, 255, 0.96); border-top: 1px solid var(--line); box-shadow: 0 -8px 24px rgba(11,11,13,0.08); backdrop-filter: blur(10px); }
    .mbar .btn { min-height: 3.3rem; font-size: 1.05rem; }
    :global(body) { padding-bottom: 5rem; }
  }
</style>
