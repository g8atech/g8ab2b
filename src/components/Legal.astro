---
// Impaginazione delle pagine legali (privacy e cookie).
interface Props { titolo: string; aggiornato: string }
const { titolo, aggiornato } = Astro.props;
---
<section class="lg">
  <div class="wrap lg__w">
    <ol class="b-crumbs" aria-label="Percorso"><li><a href="/">Home</a></li><li aria-current="page">{titolo}</li></ol>
    <h1 class="h lg__h">{titolo}</h1>
    <p class="lg__up">Ultimo aggiornamento: {aggiornato}</p>
    <div class="lg__body"><slot /></div>
  </div>
</section>

<style>
  .lg { padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem); }
  .lg__w { max-width: 52rem; }
  .lg__h { font-size: clamp(2.2rem, 5vw, 3.4rem); }
  .lg__up { margin-top: 0.5rem; color: var(--muted); font-size: 0.9rem; }
  .lg__body { margin-top: 2rem; line-height: 1.7; }
  .lg__body :global(h2) { margin: 2.2rem 0 0.6rem; font-size: 1.35rem; }
  .lg__body :global(h3) { margin: 1.4rem 0 0.4rem; font-size: 1.08rem; }
  .lg__body :global(p), .lg__body :global(ul) { margin: 0 0 0.9rem; }
  .lg__body :global(ul) { padding-left: 1.2rem; }
  .lg__body :global(li) { margin-bottom: 0.35rem; }
  .lg__body :global(a) { color: var(--red); font-weight: 700; }
  .lg__body :global(.tbl) { overflow-x: auto; margin: 0.8rem 0 1.2rem; border: 1px solid var(--line); border-radius: 14px; }
  .lg__body :global(table) { width: 100%; border-collapse: collapse; font-size: 0.92rem; min-width: 34rem; }
  .lg__body :global(th), .lg__body :global(td) { padding: 0.65rem 0.8rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  .lg__body :global(th) { background: var(--paper); font-weight: 800; }
  .lg__body :global(tr:last-child td) { border-bottom: 0; }
  .lg__body :global(code) { font-size: 0.88em; background: var(--paper); padding: 0.1rem 0.35rem; border-radius: 5px; }
  .lg__body :global(.lg__btn) { display: inline-flex; margin: 0.4rem 0 1rem; }
</style>
