---
// Banner stelle Google: voto e numero della scheda della sede, con link alle recensioni.
import { GOOGLE } from '../../data/site';
interface Props { href?: string; dark?: boolean; size?: 'sm' | 'md' }
const { href = GOOGLE.leggi, dark = false, size = 'md' } = Astro.props;
const voto = GOOGLE.voto.toLocaleString('it-IT', { minimumFractionDigits: 1 });
const ext = href.startsWith('http');
---
<a class:list={['gb', `gb--${size}`, { 'gb--dark': dark }]} href={href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined} aria-label={`Valutazione ${voto} su 5 su Google, ${GOOGLE.recensioni} recensioni`}>
  <svg class="gb__g" viewBox="0 0 48 48" aria-hidden="true"><path fill="#4285F4" d="M45.1 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11.8c-.5 2.8-2.1 5.1-4.4 6.7v5.5h7.1c4.2-3.8 6.6-9.5 6.6-16.2z"/><path fill="#34A853" d="M24 46c5.9 0 10.9-2 14.5-5.3l-7.1-5.5c-2 1.3-4.5 2.1-7.4 2.1-5.7 0-10.6-3.9-12.3-9.1H4.4v5.7C8 41.1 15.4 46 24 46z"/><path fill="#FBBC05" d="M11.7 28.2c-.4-1.3-.7-2.7-.7-4.2s.3-2.9.7-4.2v-5.7H4.4C2.9 17.1 2 20.4 2 24s.9 6.9 2.4 9.9l7.3-5.7z"/><path fill="#EA4335" d="M24 10.7c3.2 0 6.1 1.1 8.4 3.3l6.3-6.3C34.9 4.1 29.9 2 24 2 15.4 2 8 6.9 4.4 14.1l7.3 5.7c1.7-5.2 6.6-9.1 12.3-9.1z"/></svg>
  <span class="gb__txt"><strong>Eccellente</strong><span class="gb__stars" aria-hidden="true">★★★★★</span><span class="gb__n"><b>{voto}</b> · {GOOGLE.recensioni} recensioni Google</span></span>
</a>

<style>
  .gb { display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.45rem 0.9rem 0.45rem 0.55rem; border-radius: 999px; background: #fff; border: 1px solid var(--line); box-shadow: 0 6px 18px rgba(11, 11, 13, 0.07); color: var(--ink); text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; }
  .gb:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(11, 11, 13, 0.12); color: var(--ink); }
  .gb__g { width: 26px; height: 26px; flex: none; }
  .gb__txt { display: flex; flex-wrap: wrap; align-items: center; gap: 0.15rem 0.5rem; font-size: 0.92rem; line-height: 1.2; }
  .gb__txt strong { font-weight: 800; }
  .gb__stars { color: #fbbc05; letter-spacing: 1px; font-size: 1.05rem; }
  .gb__n { color: var(--muted); font-weight: 600; }
  .gb__n b { color: var(--ink); }
  .gb--sm { padding: 0.25rem 0.7rem 0.25rem 0.35rem; box-shadow: none; }
  .gb--sm .gb__g { width: 20px; height: 20px; }
  .gb--sm .gb__txt { font-size: 0.82rem; }
  .gb--sm .gb__stars { font-size: 0.9rem; }
  .gb--dark { background: transparent; border-color: rgba(255, 255, 255, 0.18); color: #fff; }
  .gb--dark:hover { color: #fff; }
  .gb--dark .gb__n { color: #c3c6cd; }
  .gb--dark .gb__n b { color: #fff; }
</style>
