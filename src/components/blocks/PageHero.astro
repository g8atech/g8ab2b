---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import PressBar from './PressBar.astro';
import { SITE, waLink, telLink } from '../../data/site';
interface Props { kicker: string; crumb: string; lead: string; waText: string; image?: ImageMetadata; imageAlt?: string; chips?: string[]; note?: string[] }
const { kicker, crumb, lead, waText, image, imageAlt = '', chips = [], note = ['Nessun vincolo', 'Assistenza inclusa', 'Garanzia 30 giorni'] } = Astro.props;
---
<section class="b-hero">
  <div class="wrap b-hero__row">
    <div class="b-hero__copy">
      <ol class="b-crumbs" aria-label="Percorso"><li><a href="/">Home</a></li><li aria-current="page">{crumb}</li></ol>
      <span class="kicker">{kicker}</span>
      <h1 class="h b-hero__h1"><slot name="title" /></h1>
      <p class="lead b-hero__lead">{lead}</p>
      <div class="b-actions">
        <a class="btn btn--red" href={telLink}><Icon name="phone" />Chiama {SITE.phone}</a>
        <a class="btn btn--wa" href={waLink(waText)}><Icon name="wa" />Scrivici su WhatsApp</a>
      </div>
      <slot name="after-actions" />
      <p class="b-hero__note">{note.map((n) => <span><Icon name="check" size={16} width={3} />{n}</span>)}</p>
    </div>
    <div class="b-hero__visual">
      <span class="b-hero__glow" aria-hidden="true"></span>
      <span class="b-hero__ring" aria-hidden="true"></span>
      <slot name="visual">
        {image && <div class="b-hero__photo"><Image src={image} alt={imageAlt} widths={[560, 900]} sizes="(max-width: 900px) 100vw, 560px" loading="eager" /></div>}
      </slot>
      {chips.map((c, i) => <span class={`b-chip b-chip--${i + 1}`} aria-hidden="true">{i < 2 && <Icon name="check" size={14} width={3.2} />}{c}</span>)}
    </div>
    <div class="b-hero__press"><PressBar row label="Ne hanno parlato" /></div>
  </div>
</section>
