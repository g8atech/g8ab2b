---
import Icon from '../Icon.astro';
import { CASI } from '../../data/clienti';
interface Props { ids?: string[]; kicker?: string; lead?: string; more?: boolean }
const { ids, kicker = 'Protocollo Emergency G8A', lead, more = false } = Astro.props;
const list = ids ? ids.map((id) => CASI.find((c) => c.id === id)!) : CASI;
---
<section class="section section--ink">
  <div class="wrap">
    <div class="b-head" data-reveal>
      <span class="kicker">{kicker}</span>
      <h2 class="h h2"><slot /></h2>
      {lead && <p class="lead">{lead}</p>}
    </div>
    <div class="b-cases" style={`--cols:${Math.min(3, list.length)}`}>
      {list.map((c, i) => (
        <article class="b-case" data-reveal style={`--d:${i * 0.1}s`}>
          <div class="b-case__top">
            <span class="b-case__tag"><Icon name={c.icon} size={16} width={2.2} />Caso reale · {c.luogo}</span>
            <h3 class="b-case__t">{c.titolo}</h3>
            <p class="b-case__who">{c.cliente} · {c.referente}</p>
            <p class="b-case__time"><strong>{c.fermo}</strong><span>di fermo totale</span></p>
          </div>
          <div class="b-case__body">
            <div><h4>La situazione</h4><p>{c.situazione}</p></div>
            <div><h4>Il nostro intervento</h4><ol>{c.intervento.map((x) => <li>{x}</li>)}</ol></div>
            <p class="b-case__ok"><Icon name="check" size={18} width={3} />{c.esito}</p>
          </div>
        </article>
      ))}
    </div>
    {more && <a class="b-more" style="color:#ff6b6b" href="/testimonianze-casistudio">Tutti i casi studio →</a>}
  </div>
</section>
