---
// Scena animata del calcolatore: l'ufficio prende vita mentre il visitatore aggiunge dispositivi.
// Ogni elemento ha data-s="chiave"; lo script del Calcolatore lo accende con la classe .on.
import { getImage } from 'astro:assets';
import zenithSrc from '../../assets/pc-zenith.png';
import stampanteSrc from '../../assets/stampante-brother.png';

const zenith = await getImage({ src: zenithSrc, width: 220, format: 'webp' });
const stampante = await getImage({ src: stampanteSrc, width: 180, format: 'webp' });

// 10 postazioni su due file da 5 (coordinate in % della scena)
const SLOT_X = [21, 31.5, 42, 52.5, 63];
const slots = Array.from({ length: 10 }, (_, i) => ({ x: SLOT_X[i % 5], y: i < 5 ? 31 : 55, d: i }));
---
<div class="ufc" data-stage style="--life:0">
  <div class="ufc__room" aria-hidden="true">
    <div class="ufc__glow"></div>
    <div class="ufc__floor"></div>
    <span class="ufc__desk" style="top:45%"></span>
    <span class="ufc__desk" style="top:69%"></span>
    <div class="ufc__rack"><span>Rack G8A</span></div>
  </div>

  <svg class="ufc__net" viewBox="0 0 100 70" preserveAspectRatio="none" aria-hidden="true">
    <path class="ufc__ln ufc__ln--lan" data-s="lan" d="M82 30 H78.5 V31.6 H19 M78.5 31.6 V48.4 H19" />
    <path class="ufc__ln ufc__ln--bk" data-s="backup" d="M8.5 6.5 H77 V13.6 H83" />
    <path class="ufc__ln ufc__ln--fibra" data-s="fibra" d="M12 16.4 H83" />
  </svg>

  <!-- Linea di backup: antenna 5G -->
  <div class="ufc__el ufc__ant" data-s="backup" style="left:2.5%;top:2%;width:6%">
    <svg viewBox="0 0 40 60"><path d="M20 22v34M12 56h16" stroke="#cfd2d8" stroke-width="3" fill="none" stroke-linecap="round"/><circle cx="20" cy="18" r="5" fill="#ffb020"/><path class="ufc__wave" d="M10 10a14 14 0 0 1 20 0M5 4a21 21 0 0 1 30 0" stroke="#ffb020" stroke-width="2.5" fill="none" stroke-linecap="round"/></svg>
    <b>5G</b>
  </div>

  <!-- Fibra FibraHero: presa a muro -->
  <div class="ufc__el ufc__plate" data-s="fibra" style="left:2%;top:18%;width:10%">
    <i></i><span>Fibra<br/>Hero</span>
  </div>

  <!-- Wi-Fi a soffitto -->
  <div class="ufc__el ufc__ap" data-s="wifi" style="left:42.5%;top:1%;width:11%">
    <span class="ufc__apdisc"></span>
    <span class="ufc__ring"></span><span class="ufc__ring" style="animation-delay:.6s"></span><span class="ufc__ring" style="animation-delay:1.2s"></span>
    <em class="ufc__n" data-n="wifi"></em>
  </div>

  <!-- Centralino cloud -->
  <div class="ufc__el ufc__cloud" data-s="centralino" style="left:63%;top:2%;width:13%">
    <svg viewBox="0 0 64 40"><path d="M16 36h34a11 11 0 0 0 0-22 15 15 0 0 0-29-3A12 12 0 0 0 16 36z" fill="#fff" opacity=".95"/><path d="M27 17c1.5 4 4 6.5 8 8l2.3-2.3c.4-.4 1-.5 1.5-.3l3.2 1.3c.5.2.8.7.8 1.2V28c0 .8-.7 1.4-1.5 1.4-9 0-16.3-7.3-16.3-16.3 0-.8.6-1.5 1.4-1.5h3c.5 0 1 .3 1.2.8l1.3 3.2c.2.5.1 1.1-.3 1.5z" fill="#e30613"/></svg>
    <span class="ufc__call"></span>
  </div>

  <!-- Rack: firewall, NAS, UPS -->
  <div class="ufc__el ufc__fw" data-s="firewall" style="left:82.5%;top:19%;width:14%">
    <svg viewBox="0 0 70 16"><rect x="1" y="1" width="68" height="14" rx="3" fill="#1d1f25" stroke="#3a3d46"/><path d="M10 4.5l4-1.5 4 1.5v3.5c0 2.5-4 4.5-4 4.5s-4-2-4-4.5z" fill="#e30613"/><g class="ufc__scan"><circle cx="34" cy="8" r="1.4"/><circle cx="40" cy="8" r="1.4"/><circle cx="46" cy="8" r="1.4"/><circle cx="52" cy="8" r="1.4"/><circle cx="58" cy="8" r="1.4"/></g></svg>
  </div>
  <div class="ufc__el ufc__nas" data-s="nas" style="left:83.5%;top:33%;width:12%">
    <svg viewBox="0 0 60 34"><rect x="1" y="1" width="58" height="32" rx="4" fill="#2a2d35" stroke="#454955"/><g fill="#15171c" stroke="#3f434d"><rect x="7" y="6" width="9" height="22" rx="1.5"/><rect x="19" y="6" width="9" height="22" rx="1.5"/><rect x="31" y="6" width="9" height="22" rx="1.5"/><rect x="43" y="6" width="9" height="22" rx="1.5"/></g><g class="ufc__leds"><circle cx="11.5" cy="24" r="1.3"/><circle cx="23.5" cy="24" r="1.3"/><circle cx="35.5" cy="24" r="1.3"/><circle cx="47.5" cy="24" r="1.3"/></g></svg>
    <em class="ufc__n" data-n="nas"></em>
  </div>
  <div class="ufc__el ufc__ups" data-s="ups" style="left:83.5%;top:56%;width:12%">
    <svg viewBox="0 0 60 30"><rect x="1" y="1" width="58" height="28" rx="4" fill="#1d1f25" stroke="#3a3d46"/><rect x="8" y="9" width="30" height="12" rx="2" fill="none" stroke="#16c172" stroke-width="1.5"/><rect x="38" y="12.5" width="2.5" height="5" fill="#16c172"/><rect class="ufc__bat" x="10" y="11" width="26" height="8" rx="1" fill="#16c172"/><path d="M50 8l-4 7h4l-3 7" stroke="#ffb020" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
    <em class="ufc__n" data-n="ups"></em>
  </div>

  <!-- Stampante -->
  <div class="ufc__el ufc__prn" data-s="stampanti" style="left:3%;top:47%;width:12%">
    <span class="ufc__paper"></span>
    <img src={stampante.src} alt="" loading="lazy" decoding="async" />
    <em class="ufc__n" data-n="stampanti"></em>
  </div>

  <!-- Postazioni: PC G8A in noleggio o PC del cliente gestito -->
  {slots.map((s) => (
    <div class="ufc__slot" data-slot={s.d} style={`left:${s.x}%;top:${s.y}%`}>
      <div class="ufc__pc ufc__pc--g8a">
        <img src={zenith.src} alt="" loading="lazy" decoding="async" />
        <span class="ufc__screen"></span>
      </div>
      <div class="ufc__pc ufc__pc--own">
        <svg viewBox="0 0 60 56"><rect x="3" y="3" width="54" height="36" rx="3" fill="#3a3d46"/><rect x="6" y="6" width="48" height="30" rx="1.5" fill="#1b1d23"/><path d="M25 39h10l2 11H23z" fill="#6b6f7a"/><rect x="16" y="50" width="28" height="3" rx="1.5" fill="#6b6f7a"/><path d="M30 13l7 2.5v5.5c0 4.5-7 8-7 8s-7-3.5-7-8v-5.5z" fill="#16c172"/><path d="M26.5 21l2.5 2.5 4.5-4.5" stroke="#06381f" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
      </div>
      <span class="ufc__phone"></span>
    </div>
  ))}
  <em class="ufc__more" data-more></em>

  <p class="ufc__status" data-status>Il tuo ufficio è vuoto: aggiungi un PC</p>
  <div class="ufc__tot"><small>Il tuo canone</small><b>da <span data-o="tot">0,00</span> €</b><i>/mese</i></div>
</div>

<style>
  .ufc { position: relative; aspect-ratio: 10 / 7; border-radius: 22px; overflow: hidden; background: #0b0b0d; color: #fff; isolation: isolate; box-shadow: 0 30px 70px rgba(11, 11, 13, .28); }
  .ufc__room, .ufc__net { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ufc__room { background: linear-gradient(#16161b, #101014 78%); }
  .ufc__glow { position: absolute; inset: 0; background: radial-gradient(60% 55% at 48% 52%, rgba(255, 40, 40, calc(.08 + .32 * var(--life))), transparent 70%), radial-gradient(40% 30% at 50% 0%, rgba(255, 255, 255, calc(.03 + .12 * var(--life))), transparent 70%); transition: background .8s; }
  .ufc__floor { position: absolute; left: 0; right: 0; bottom: 0; height: 22%; background: repeating-linear-gradient(90deg, rgba(255, 255, 255, .05) 0 1px, transparent 1px 9%), linear-gradient(#1c1c22, #0e0e11); transform: perspective(300px) rotateX(35deg); transform-origin: top; border-top: 1px solid rgba(255, 255, 255, .08); }
  .ufc__desk { position: absolute; left: 18%; width: 59%; height: 2.2%; border-radius: 3px; background: linear-gradient(#3b3b44, #24242a); box-shadow: 0 6px 14px rgba(0, 0, 0, .5); }
  .ufc__rack { position: absolute; left: 81%; top: 15%; width: 17%; height: 63%; border-radius: 8px; border: 1px dashed rgba(255, 255, 255, .14); background: rgba(255, 255, 255, .02); }
  .ufc__rack span { position: absolute; bottom: 4%; left: 0; right: 0; text-align: center; font-size: clamp(.5rem, 1.1vw, .62rem); letter-spacing: .14em; text-transform: uppercase; color: rgba(255, 255, 255, .3); font-weight: 800; }

  .ufc__ln { fill: none; vector-effect: non-scaling-stroke; stroke-linecap: round; opacity: 0; transition: opacity .6s; }
  .ufc__ln.on { opacity: 1; }
  .ufc__ln--fibra { stroke: #ff2a2a; stroke-width: 3; stroke-dasharray: 2 6; filter: drop-shadow(0 0 4px #ff1a1a); animation: ufc-flow 1.1s linear infinite; }
  .ufc__ln--bk { stroke: #ffb020; stroke-width: 2; stroke-dasharray: 3 7; animation: ufc-flow 2.2s linear infinite; }
  .ufc__ln--lan { stroke: rgba(255, 90, 90, .55); stroke-width: 1.6; stroke-dasharray: 1 5; animation: ufc-flow 1.6s linear infinite; }
  @keyframes ufc-flow { to { stroke-dashoffset: -32; } }

  .ufc__el, .ufc__pc, .ufc__phone { opacity: 0; transform: translateY(14px) scale(.6); transition: opacity .45s, transform .6s cubic-bezier(.34, 1.56, .64, 1); pointer-events: none; }
  .ufc__el { position: absolute; }
  .ufc__el.on, .ufc__pc.on, .ufc__phone.on { opacity: 1; transform: none; }
  .ufc__el svg, .ufc__el img { display: block; width: 100%; height: auto; }
  .ufc__n { position: absolute; top: -10%; right: -8%; min-width: 1.4em; padding: .1em .35em; border-radius: 999px; background: #e30613; font: 800 clamp(.5rem, 1.2vw, .7rem)/1.3 var(--font); font-style: normal; text-align: center; opacity: 0; transform: scale(.5); transition: .3s; }
  .ufc__n.on { opacity: 1; transform: none; }

  .ufc__ant b { position: absolute; left: 100%; top: 18%; font-size: clamp(.45rem, 1vw, .6rem); color: #ffb020; }
  .ufc__wave { animation: ufc-blink 1.4s ease-in-out infinite; }
  @keyframes ufc-blink { 50% { opacity: .25; } }
  .ufc__plate { aspect-ratio: 1.7; border-radius: 6px; background: #f2f3f5; color: #0b0b0d; box-shadow: 0 6px 14px rgba(0, 0, 0, .45); }
  .ufc__plate i { position: absolute; left: 10%; top: 50%; width: 22%; aspect-ratio: 1; transform: translateY(-50%); border-radius: 50%; background: #e30613; box-shadow: 0 0 0 2px #0b0b0d inset, 0 0 10px #ff1a1a; animation: ufc-pulse 1.6s ease-in-out infinite; }
  .ufc__plate span { position: absolute; left: 40%; top: 50%; transform: translateY(-50%); font: 900 clamp(.38rem, .9vw, .58rem)/1.05 var(--font); text-transform: uppercase; }
  @keyframes ufc-pulse { 50% { box-shadow: 0 0 0 2px #0b0b0d inset, 0 0 22px 4px #ff1a1a; } }

  .ufc__ap { aspect-ratio: 2 / 1; }
  .ufc__apdisc { position: absolute; left: 20%; right: 20%; top: 0; height: 28%; border-radius: 0 0 50% 50% / 0 0 100% 100%; background: #f2f3f5; box-shadow: 0 2px 0 #c9ccd2; }
  .ufc__apdisc::after { content: ''; position: absolute; left: 46%; bottom: 22%; width: 8%; aspect-ratio: 1; border-radius: 50%; background: #3fb6ff; box-shadow: 0 0 6px #3fb6ff; }
  .ufc__ring { position: absolute; left: 50%; top: 10%; width: 30%; aspect-ratio: 2 / 1; border: 2px solid #3fb6ff; border-top: 0; border-radius: 0 0 999px 999px; transform: translateX(-50%); opacity: 0; animation: ufc-ring 1.8s ease-out infinite; }
  @keyframes ufc-ring { 0% { width: 20%; opacity: .9; } 100% { width: 160%; top: 40%; opacity: 0; } }

  .ufc__cloud { aspect-ratio: 64 / 40; }
  .ufc__call { position: absolute; left: 42%; top: 40%; width: 18%; aspect-ratio: 1; border-radius: 50%; border: 2px solid #e30613; animation: ufc-call 1.5s ease-out infinite; }
  @keyframes ufc-call { from { transform: scale(.6); opacity: 1; } to { transform: scale(2.6); opacity: 0; } }

  .ufc__scan circle { fill: #2b2e36; animation: ufc-scan 1.5s infinite; }
  .ufc__scan circle:nth-child(2) { animation-delay: .15s; } .ufc__scan circle:nth-child(3) { animation-delay: .3s; } .ufc__scan circle:nth-child(4) { animation-delay: .45s; } .ufc__scan circle:nth-child(5) { animation-delay: .6s; }
  @keyframes ufc-scan { 0%, 30% { fill: #ff2a2a; } 60%, 100% { fill: #2b2e36; } }
  .ufc__leds circle { fill: #16c172; animation: ufc-blink .9s steps(2) infinite; }
  .ufc__leds circle:nth-child(2) { animation-duration: 1.3s; } .ufc__leds circle:nth-child(3) { animation-duration: .7s; } .ufc__leds circle:nth-child(4) { animation-duration: 1.1s; }
  .ufc__bat { transform-origin: 10px 15px; animation: ufc-charge 2.4s ease-in-out infinite; }
  @keyframes ufc-charge { 0% { transform: scaleX(.25); } 70%, 100% { transform: scaleX(1); } }

  .ufc__prn img { filter: drop-shadow(0 8px 10px rgba(0, 0, 0, .55)); }
  .ufc__paper { position: absolute; left: 30%; width: 40%; top: 30%; height: 18%; background: #fff; border-radius: 2px; z-index: -1; }
  .ufc__prn.on .ufc__paper { animation: ufc-print 2.8s ease-in-out .6s infinite; }
  @keyframes ufc-print { 0%, 20% { transform: translateY(0); opacity: 0; } 40% { opacity: 1; } 70%, 100% { transform: translateY(-80%); opacity: 0; } }

  .ufc__slot { position: absolute; width: 10%; aspect-ratio: 1 / 1.05; }
  .ufc__pc { position: absolute; inset: 0; }
  .ufc__pc img, .ufc__pc svg { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 6px 8px rgba(0, 0, 0, .6)); }
  .ufc__screen { position: absolute; left: 4%; right: 4%; top: 3%; height: 56%; border-radius: 3px; background: radial-gradient(80% 80% at 50% 40%, rgba(255, 60, 60, .55), rgba(227, 6, 19, .1) 60%, transparent); mix-blend-mode: screen; opacity: 0; }
  .ufc__pc--g8a.on .ufc__screen { animation: ufc-boot 1.2s .35s ease-out forwards, ufc-breathe 3.5s 1.6s ease-in-out infinite; }
  @keyframes ufc-boot { 0% { opacity: 0; } 30% { opacity: 1; } 45% { opacity: .2; } 100% { opacity: .75; } }
  @keyframes ufc-breathe { 50% { opacity: .45; } }
  .ufc__phone { position: absolute; right: -14%; bottom: -2%; width: 22%; aspect-ratio: 1 / 1.9; border-radius: 3px; background: #e9eaee; border: 2px solid #1b1d23; box-shadow: 0 0 8px rgba(63, 182, 255, .6); }
  .ufc__phone::after { content: ''; position: absolute; inset: 12% 10%; border-radius: 1px; background: linear-gradient(#3fb6ff, #1b6fd1); }
  .ufc__more { position: absolute; left: 74%; top: 60%; padding: .15em .5em; border-radius: 999px; background: #e30613; font: 800 clamp(.55rem, 1.2vw, .75rem)/1.3 var(--font); font-style: normal; opacity: 0; transition: .3s; }
  .ufc__more.on { opacity: 1; }

  .ufc__status { position: absolute; left: 0; right: 0; bottom: 3%; text-align: center; font-weight: 700; font-size: clamp(.62rem, 1.4vw, .85rem); color: rgba(255, 255, 255, .78); }
  .ufc__status b { color: #16c172; }
  .ufc__tot { position: absolute; right: 2.5%; bottom: 3%; display: none; flex-direction: column; align-items: flex-end; padding: .25rem .6rem; border-radius: 12px; background: rgba(11, 11, 13, .82); backdrop-filter: blur(6px); border: 1px solid rgba(255, 255, 255, .12); }
  .ufc__tot small { font-size: .62rem; text-transform: uppercase; letter-spacing: .1em; color: #ff8a8a; font-weight: 800; }
  .ufc__tot b { font-size: 1rem; font-weight: 900; line-height: 1.1; }
  .ufc__tot i { display: none; }
  .ufc__tot small { font-size: .55rem; }
  .ufc.pop { animation: ufc-pop .5s ease-out; }
  @keyframes ufc-pop { 40% { box-shadow: 0 0 0 4px rgba(227, 6, 19, .45), 0 30px 70px rgba(11, 11, 13, .28); } }

  @media (prefers-reduced-motion: reduce) {
    .ufc *, .ufc { animation: none !important; transition: opacity .2s !important; }
    .ufc__screen { opacity: .7; }
  }
</style>
