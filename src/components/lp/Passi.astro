---
// Cosa succede dopo il contatto: pochi passi chiari tolgono la paura di chiamare.
interface Props { kicker?: string; items: { t: string; d: string }[] }
const { kicker = 'Come si parte', items } = Astro.props;
---
<section class="section">
  <div class="wrap">
    <div class="b-head" data-reveal>
      <span class="kicker">{kicker}</span>
      <h2 class="h h2"><slot /></h2>
    </div>
    <ol class="ps">
      {items.map((x, i) => (
        <li class="ps__i" data-reveal style={`--d:${i * 0.1}s`}>
          <span class="ps__n">{i + 1}</span>
          <h3>{x.t}</h3>
          <p>{x.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .ps { list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; counter-reset: ps; }
  .ps__i { position: relative; padding: 1.6rem; border-radius: 18px; background: var(--paper); border: 1px solid var(--line); }
  .ps__i:not(:last-child)::after { content: ''; position: absolute; top: 2.55rem; right: -0.9rem; width: 0.8rem; height: 2px; background: var(--red); }
  .ps__n { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: var(--grad); color: #fff; font-weight: 800; font-size: 1.15rem; box-shadow: 0 0 0 6px rgba(227, 6, 19, 0.12); }
  .ps__i h3 { margin-top: 1rem; font-size: 1.15rem; }
  .ps__i p { margin-top: 0.4rem; color: var(--muted); }
  @media (max-width: 900px) { .ps__i::after { display: none; } }
</style>
