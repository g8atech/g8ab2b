---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE, SEDI, GRUPPO, FAQ, waLink, telLink } from '../data/site';
import heroG8a from '../assets/hero-g8a.png';
import robotCoppia from '../assets/robot-coppia.jpg';
import fondatori from '../assets/fondatori.png';
import milani from '../assets/milani.jpg';
import testa from '../assets/testa.jpg';
import cde from '../assets/press-corriere-economia.png';
import vn from '../assets/press-varesenews.png';
import fortune from '../assets/press-fortune-italia.png';
import economy from '../assets/press-economy.png';

const press = [
  { src: vn, alt: 'VareseNews', h: 28 },
  { src: cde, alt: "Corriere dell'Economia", h: 40 },
  { src: economy, alt: 'Economy', h: 28 },
  { src: fortune, alt: 'Fortune Italia', h: 24 },
];
const rotating = ['alla stampante', 'al server', 'alla fibra', 'al firewall', 'al centralino', "all'intelligenza artificiale"];
const ticker = ['Assistenza IT', 'Noleggio PC', 'Server e backup', 'Stampanti', 'Fibra aziendale', 'Firewall', 'Centralino cloud', 'Sicurezza informatica', 'Intelligenza artificiale'];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title="Assistenza informatica e Noleggio Assistito per aziende | G8A Technology"
  description="Il reparto IT esterno delle PMI tra Varese, Milano e Lecco: PC e server a noleggio, stampanti, fibra, sicurezza e AI con un solo numero. Ti risponde una persona, non un call center."
  jsonLd={[faqLd]}
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__grid-bg" aria-hidden="true"></div>
    <div class="hero__scan" aria-hidden="true"></div>
    <div class="wrap hero__row">
      <div class="hero__copy">
        <span class="pill"><span class="live"></span>Reparto IT per le PMI · Varese · Milano · Lecco</span>
        <h1 class="h hero__h1">
          Tu pensi alla tua azienda.
          <span class="hero__big" data-text="Al resto ci pensiamo noi">Al resto ci pensiamo noi</span>
        </h1>
        <p class="rot">
          <span class="rot__lbl">Dal PC</span>
          <span class="rot__win" aria-hidden="true"><span class="rot__list">{[...rotating, rotating[0]].map((r) => <span>{r}</span>)}</span></span>
          <span class="visually-hidden">alla stampante, al server, alla fibra, al firewall, al centralino e all'intelligenza artificiale</span>
        </p>
        <p class="lead">Un solo numero per tutta la tua tecnologia. E se qualcosa si ferma, ci siamo: ti risponde una persona, non un call center.</p>
        <div class="hero__actions">
          <a class="btn btn--wa" href={waLink('Ciao, vi scrivo dalla home di g8a.it, vorrei informazioni per la mia azienda.')}><Icon name="wa" />Scrivici su WhatsApp</a>
          <a class="btn btn--red" href={telLink}><Icon name="phone" />Chiama {SITE.phone}</a>
        </div>
      </div>
      <div class="hero__visual">
        <div class="holo" aria-hidden="true"><span></span><span></span><span></span></div>
        <span class="hero__badge">1 numero<br />per tutto</span>
        <Image class="hero__img" src={heroG8a} alt="Supereroe G8A in armatura robotica" widths={[435]} loading="eager" />
      </div>
    </div>
    <ul class="wrap hero__strip">
      <li><Icon name="pc" size={26} stroke="#ff6a5a" /><span><strong>PC e server</strong><br />a noleggio, sempre aggiornati</span></li>
      <li><Icon name="printer" size={26} stroke="#ff6a5a" /><span><strong>Stampanti</strong><br />toner e manutenzione inclusi</span></li>
      <li><Icon name="shield" size={26} stroke="#ff6a5a" /><span><strong>Reti e sicurezza</strong><br />fibra, firewall, backup</span></li>
      <li><Icon name="bot" size={26} stroke="#ff6a5a" /><span><strong>AI per aziende</strong><br />formazione e assistenti</span></li>
    </ul>
  </section>

  <!-- NASTRO -->
  <div class="tk" aria-hidden="true">
    <div class="tk__track">{[...ticker, ...ticker].map((t) => <span>{t}</span>)}</div>
  </div>

  <!-- STAMPA -->
  <section class="press" aria-labelledby="press-h">
    <div class="wrap press__row">
      <h2 id="press-h" class="press__h">Comparsi su</h2>
      <ul>{press.map((l) => <li><Image src={l.src} alt={l.alt} height={l.h} densities={[1, 2]} /></li>)}</ul>
    </div>
  </section>

  <!-- CONSOLE -->
  <section class="section">
    <div class="wrap split">
      <div class="split__text" data-reveal>
        <div class="rule"></div>
        <h2 class="h h2">Il blocco informatico di domani mattina? <span class="accent">Lo vediamo arrivare oggi.</span></h2>
        <p class="lead" style="margin-top:1.4rem">Monitoriamo computer, server, backup e rete 24 ore su 24 dalla nostra console. Quando un disco si sta rompendo, un backup salta o un antivirus si spegne, interveniamo prima che tu te ne accorga.</p>
        <p class="lead" style="margin-top:1rem">Tu non fai più il tecnico dell'ufficio. Lo facciamo noi.</p>
      </div>
      <div class="console" data-reveal style="--d:.15s">
        <div class="console__top"><span class="console__title"><span class="live"></span>Console G8A · la tua azienda</span><span class="console__tag">Esempio</span></div>
        <div class="console__kpi">
          <div><span>Postazioni monitorate</span><strong>12 / 12</strong></div>
          <div><span>Ultimo backup</span><strong class="ok">OK</strong></div>
        </div>
        <ul class="console__bars">
          <li><div><span>Aggiornamenti di sicurezza</span><b>installati</b></div><i class="bar"><i style="width:100%"></i></i></li>
          <li><div><span>Spazio server</span><b>64%</b></div><i class="bar"><i style="width:64%"></i></i></li>
          <li><div><span>Toner stampante ufficio</span><b class="warn">in consegna</b></div><i class="bar"><i style="width:18%"></i></i></li>
        </ul>
        <div class="console__alert"><Icon name="alert" size={20} stroke="#ff6a5a" /><span>Disco del PC di amministrazione in degrado: <strong>sostituzione già programmata</strong>, nessun dato perso.</span></div>
      </div>
    </div>
  </section>

  <!-- NUMERI -->
  <section class="section--alt">
    <ul class="wrap stats" data-reveal>
      <li><span class="stats__n" data-count="500" data-post="+">500+</span><span class="stats__l">aziende e professionisti seguiti</span></li>
      <li><span class="stats__n" data-count="15" data-pre="~" data-post=" anni">~15 anni</span><span class="stats__l">di IT per le imprese</span></li>
      <li><span class="stats__n" data-count="6" data-post=" sedi">6 sedi</span><span class="stats__l">tra Varese, Milano e Lecco</span></li>
      <li><span class="stats__n">0</span><span class="stats__l">call center: rispondono i nostri tecnici</span></li>
    </ul>
  </section>

  <!-- SERVIZI -->
  <section class="section" id="servizi">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2 class="h h2">Tutta la tua tecnologia. <span class="accent">Un solo partner.</span></h2>
        <p class="muted">Scegli un servizio o affidaci tutto: più servizi unisci, più semplice diventa.</p>
      </div>
      <div class="bento">
        <a href="#metodo" class="card card--wide glow" data-reveal>
          <span class="card__body">
            <span class="chip">Il nostro metodo</span>
            <span class="h card__big">Noleggio Assistito</span>
            <span class="card__txt">PC, server, stampanti e assistenza in un canone mensile. Niente investimento iniziale, niente costi a chiamata, sostituzione inclusa.</span>
          </span>
          <span class="card__go">Scopri come funziona →</span>
        </a>
        <a href="#metodo" class="card glow" data-reveal><Icon name="wrench" size={34} stroke="#ff3b2f" width={1.8} /><span class="card__t">Assistenza IT</span><span class="card__txt">Da remoto e in sede, con un solo numero per tutto.</span></a>
        <a href="#metodo" class="card glow" data-reveal style="--d:.08s"><Icon name="server" size={34} stroke="#ff3b2f" width={1.8} /><span class="card__t">Server e backup</span><span class="card__txt">Dati al sicuro con backup automatici e controllati.</span></a>
        <a href="#metodo" class="card glow" data-reveal style="--d:.16s"><Icon name="printer" size={34} stroke="#ff3b2f" width={1.8} /><span class="card__t">Noleggio stampanti</span><span class="card__txt">Multifunzione con toner e manutenzione inclusi.</span></a>
        <a href="https://www.fibrahero.it" class="card glow" data-reveal><Icon name="wifi" size={34} stroke="#ff3b2f" width={1.8} /><span class="card__t">Fibra e centralino</span><span class="card__txt">Con FibraHero: G8A è il tuo operatore.</span></a>
        <a href="#metodo" class="card glow" data-reveal style="--d:.08s"><Icon name="shieldok" size={34} stroke="#ff3b2f" width={1.8} /><span class="card__t">Sicurezza informatica</span><span class="card__txt">Firewall, antivirus gestito, protezione ransomware, GDPR.</span></a>
        <a href="#ai" class="card glow" data-reveal style="--d:.16s"><Icon name="bot" size={34} stroke="#ff3b2f" width={1.8} /><span class="card__t">AI per aziende</span><span class="card__txt">Formazione e assistenti AI per il tuo team e i tuoi clienti.</span></a>
      </div>
    </div>
  </section>

  <!-- METODO -->
  <section class="section section--alt" id="metodo">
    <div class="wrap">
      <h2 class="h h2" data-reveal style="max-width:52rem">Operativi in <span class="accent">1–4 giorni.</span> Senza fermare l'ufficio.</h2>
      <div class="line" aria-hidden="true"></div>
      <ol class="steps">
        <li data-reveal><span class="steps__n">01</span><span class="steps__t">Scrivici o chiamaci</span><span class="steps__d">Ti risponde subito una persona del team, su WhatsApp o al telefono.</span></li>
        <li data-reveal style="--d:.1s"><span class="steps__n">02</span><span class="steps__t">Analisi in sede</span><span class="steps__d">Un tecnico vede PC, rete, stampanti e backup e ti propone un canone unico.</span></li>
        <li data-reveal style="--d:.2s"><span class="steps__n">03</span><span class="steps__t">Installazione chiavi in mano</span><span class="steps__d">PC configurati su misura e dati migrati, di solito in 1–4 giorni lavorativi.</span></li>
        <li data-reveal style="--d:.3s"><span class="steps__n">04</span><span class="steps__t">Ci pensiamo noi</span><span class="steps__d">Monitoraggio, aggiornamenti e sostituzioni inclusi. Nessun vincolo, disdetta libera.</span></li>
      </ol>
    </div>
  </section>

  <!-- AI -->
  <section class="ai" id="ai">
    <div class="ai__grid" aria-hidden="true"></div>
    <div class="wrap ai__row">
      <div data-reveal>
        <span class="pill"><span class="live" style="background:#ff3b2f"></span>Già attivo nelle aziende</span>
        <h2 class="h ai__h">Intelligenza artificiale per la tua azienda</h2>
        <p class="lead" style="margin-top:1.1rem">Portiamo l'AI dove fa risparmiare tempo davvero: nel tuo team, nei tuoi clienti, nei tuoi dati. Con formazione in presenza e strumenti pronti.</p>
      </div>
      <ul class="ai__list">
        <li class="glow" data-reveal><span class="chip">Formazione</span><h3>Corsi AI per titolari e team</h3><p>Claude, ChatGPT e AI Act, con esercizi sul tuo lavoro.</p></li>
        <li class="glow" data-reveal style="--d:.08s"><span class="chip">WhatsApp</span><h3>Assistente AI per i clienti</h3><p>Risponde, raccoglie richieste e fissa appuntamenti, anche fuori orario.</p></li>
        <li class="glow" data-reveal style="--d:.16s"><span class="chip">Centralino · in arrivo</span><h3>Voce AI al telefono</h3><p>Per chi ha già un centralino, mantenendo i propri numeri.</p></li>
        <li class="glow" data-reveal style="--d:.24s"><span class="chip">Su misura</span><h3>I tuoi dati, interrogabili</h3><p>Un archivio unico dei dati aziendali su cui usare l'AI.</p></li>
      </ul>
    </div>
  </section>

  <!-- CHI SIAMO -->
  <section class="section">
    <div class="wrap split">
      <div class="team" data-reveal>
        <Image src={robotCoppia} alt="Giuseppe e Antonio Arrigo, fondatori di G8A, in armatura robotica" widths={[660, 1314]} sizes="(max-width: 900px) 100vw, 600px" />
      </div>
      <div class="split__text" data-reveal style="--d:.15s">
        <div class="rule"></div>
        <h2 class="h h2">Due fratelli, <span class="accent">un'ossessione:</span> l'IT che funziona.</h2>
        <p class="lead" style="margin-top:1.3rem">Giuseppe e Antonio Arrigo hanno fondato G8A circa quindici anni fa. Oggi è un gruppo con sei sedi in Lombardia, tecnici interni e un metodo, il Noleggio Assistito, di cui hanno parlato le testate economiche nazionali.</p>
        <div class="hero__actions" style="margin-top:1.8rem">
          <a class="btn btn--wa" href={waLink()}><Icon name="wa" />Parla con noi</a>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIANZE -->
  <section class="section section--alt">
    <div class="wrap">
      <h2 class="h h2" data-reveal style="max-width:52rem">Oltre 500 aziende <span class="accent">si sono riprese il loro tempo</span></h2>
      <div class="quotes">
        <figure data-reveal>
          <div class="stars" role="img" aria-label="5 stelle su 5">★★★★★</div>
          <blockquote>«La loro formula di noleggio assistito ci ha permesso di avere accesso alle migliori tecnologie senza dover sostenere un investimento iniziale eccessivo.»</blockquote>
          <figcaption><Image src={milani} alt="Marco Milani" width={52} height={52} densities={[1, 2]} /><span><strong>Marco Milani</strong><br />Titolare, Protalga Srl</span></figcaption>
        </figure>
        <figure data-reveal style="--d:.1s">
          <div class="stars" role="img" aria-label="5 stelle su 5">★★★★★</div>
          <blockquote>«Avevo bisogno di un computer per CAD e di un server per i miei dati aziendali e loro mi hanno aiutato a trovare la soluzione perfetta per le mie esigenze.»</blockquote>
          <figcaption><Image src={testa} alt="Gabriele Testa" width={52} height={52} densities={[1, 2]} /><span><strong>Geom. Gabriele Testa</strong><br />Titolare, Dream House Group Srl</span></figcaption>
        </figure>
        <figure data-reveal style="--d:.2s">
          <div class="stars" role="img" aria-label="5 stelle su 5">★★★★★</div>
          <blockquote>«Tutti molto presenti ed organizzati, sempre pronti ad intervenire in qualsiasi momento risolvendo qualsiasi problema.»</blockquote>
          <figcaption><span class="avatar" aria-hidden="true">AV</span><span><strong>Dott.ssa Antonella Vallerini</strong><br />Consulente del lavoro, Gallarate</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- GRUPPO + SEDI -->
  <section class="section" id="sedi">
    <div class="wrap duo">
      <div data-reveal>
        <h2 class="h duo__h">Un gruppo, <span class="accent">quattro specialisti</span></h2>
        <div class="tiles tiles--2">{GRUPPO.map((g) => <a class="tile glow" href={g.url}><strong>{g.name}</strong><span>{g.what}</span></a>)}</div>
      </div>
      <div data-reveal style="--d:.1s">
        <h2 class="h duo__h">Vicini alla tua azienda</h2>
        <div class="tiles">{SEDI.map((s) => <div class:list={['tile', { 'tile--hq': s.operativa }]}><strong>{s.operativa ? 'Sede operativa' : s.city}</strong><span>{s.operativa ? s.city : s.address}</span></div>)}</div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--alt">
    <div class="wrap faq">
      <h2 class="h duo__h">Domande frequenti</h2>
      {FAQ.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="wrap cta__row">
      <div>
        <h2 class="h cta__h">Smetti di fare il tecnico. <span class="hero__big cta__big" data-text="Chiamaci.">Chiamaci.</span></h2>
        <p class="lead" style="margin-top:1.1rem">Raccontaci com'è il tuo ufficio: in una telefonata capiamo come semplificarti la vita.</p>
        <div class="hero__actions">
          <a class="btn btn--wa" href={waLink('Ciao, vi scrivo dal sito g8a.it, vorrei parlare con un tecnico.')}><Icon name="wa" />Scrivici su WhatsApp</a>
          <a class="btn btn--ghost" href={telLink}><Icon name="phone" />{SITE.phone}</a>
        </div>
      </div>
      <div class="cta__visual"><Image class="cta__img" src={fondatori} alt="Giuseppe e Antonio Arrigo, fondatori di G8A Technology" widths={[400, 620]} sizes="400px" /></div>
    </div>
  </section>
</Base>

<style>
  .muted { color: var(--muted); max-width: 26rem; }
  .chip { align-self: flex-start; display: inline-block;padding: 0.15rem 0.55rem; border-radius: 4px; background: linear-gradient(90deg, var(--red), var(--red-soft)); color: #fff; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; }

  /* HERO */
  .hero { position: relative; overflow: hidden; background: radial-gradient(110% 120% at 75% 30%, #5a0b0e 0%, #2a0709 28%, #0e0b12 55%, var(--night) 100%); padding-top: clamp(2.5rem, 6vw, 4.5rem); }
  .hero__grid-bg { position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(#ffffff0a 1px, #0000 1px), linear-gradient(90deg, #ffffff0a 1px, #0000 1px); background-size: 56px 56px; -webkit-mask-image: radial-gradient(70% 70% at 70% 40%, #000, #0000 80%); mask-image: radial-gradient(70% 70% at 70% 40%, #000, #0000 80%); }
  .hero__scan { position: absolute; inset: 0; pointer-events: none; mix-blend-mode: screen; background: linear-gradient(#0000 0%, #ff3b2f10 48%, #ff3b2f30 50%, #0000 52%) 0 0 / 100% 300%; animation: scan 7s linear infinite; }
  @keyframes scan { 0% { background-position: 0 100%; } to { background-position: 0 -200%; } }
  .hero__row { position: relative; z-index: 1; display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(1rem, 4vw, 3rem); align-items: center; }
  .hero__h1 { margin-top: 1.4rem; font-size: clamp(2.4rem, 5.4vw, 4.4rem); }
  .hero__big { position: relative; display: block; margin-top: 0.5rem; font-size: clamp(3.3rem, 8.2vw, 7rem); line-height: 0.88; background: linear-gradient(180deg, #fff 0%, #ffb3ad 45%, #ff2a1f 100%); -webkit-background-clip: text; background-clip: text; color: transparent; filter: drop-shadow(0 0 24px #ff2a1f66); }
  .hero__big::after { content: attr(data-text); position: absolute; inset: 0; background: linear-gradient(100deg, #0000 35%, #fffffff2 50%, #0000 65%) 150% 0 / 250% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: sweep 4.5s ease-in-out 1s infinite; }
  @keyframes sweep { 0% { background-position: 150% 0; } 45%, to { background-position: -100% 0; } }
  .rot { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin: 1.4rem 0 1rem; font-weight: 700; font-size: clamp(1.15rem, 2vw, 1.5rem); color: #fff; }
  .rot__lbl { color: var(--muted); }
  .rot__win { display: inline-block; height: 1.5em; overflow: hidden; padding: 0 0.6rem; border-radius: 6px; background: #ff2a1f22; border: 1px solid #ff6a5a55; }
  .rot__list { display: flex; flex-direction: column; animation: rot 12s cubic-bezier(0.7, 0, 0.3, 1) infinite; }
  .rot__list span { height: 1.5em; line-height: 1.5em; white-space: nowrap; color: var(--red-soft); }
  @keyframes rot { 0%, 14% { transform: translateY(0); } 17%, 31% { transform: translateY(-1.5em); } 34%, 48% { transform: translateY(-3em); } 51%, 65% { transform: translateY(-4.5em); } 68%, 82% { transform: translateY(-6em); } 85%, 97% { transform: translateY(-7.5em); } to { transform: translateY(-9em); } }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.8rem; }
  .hero__visual { position: relative; display: grid; place-items: center; }
  .holo { position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none; }
  .holo span { position: absolute; aspect-ratio: 1; border-radius: 50%; }
  .holo span:nth-child(1) { width: 90%; border: 1.5px dashed #ff6a5a70; animation: spin 24s linear infinite; }
  .holo span:nth-child(2) { width: 72%; border: 3px solid; border-color: #ff2a1f66 #0000; animation: spin 9s linear infinite reverse; }
  .holo span:nth-child(3) { width: 104%; border: 1px solid #ffffff14; box-shadow: inset 0 0 70px #ff2a1f30, 0 0 90px #ff2a1f30; animation: pulse 3.5s ease-in-out infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes pulse { 50% { opacity: 0.6; transform: scale(1.04); } }
  .hero__visual :global(.hero__img) { position: relative; z-index: 1; width: min(100%, 460px); -webkit-mask-image: radial-gradient(closest-side, #000 70%, #0000 100%); mask-image: radial-gradient(closest-side, #000 70%, #0000 100%); animation: fly 6s ease-in-out infinite; }
  @keyframes fly { 0%, to { transform: translate(0) rotate(0); } 50% { transform: translate(-6px, -14px) rotate(-1.2deg); } }
  .hero__badge { position: absolute; z-index: 2; top: 6%; left: 2%; padding: 0.6rem 1rem; background: linear-gradient(90deg, var(--red), var(--red-hot)); border-left: 4px solid #fff; transform: skew(-6deg); font-stretch: 80%; font-variation-settings: 'wdth' 80; text-transform: uppercase; font-weight: 800; font-size: 1.1rem; line-height: 1.05; color: #fff; }
  .hero__strip { position: relative; z-index: 1; list-style: none; margin-top: clamp(1rem, 3vw, 2rem); padding: 1.4rem 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; border-top: 1px solid #ff6a5a33; }
  .hero__strip li { display: flex; gap: 0.8rem; align-items: flex-start; color: var(--muted); font-size: 0.95rem; }
  .hero__strip strong { color: #fff; font-size: 1.05rem; }
  @media (max-width: 900px) {
    .hero__row { grid-template-columns: 1fr; }
    .hero__visual { max-width: 380px; margin-inline: auto; }
    .hero__strip { grid-template-columns: 1fr 1fr; }
  }

  /* NASTRO */
  .tk { overflow: hidden; background: linear-gradient(90deg, #8e0f14, var(--red), #8e0f14); color: #fff; padding-block: 0.85rem; border-block: 1px solid #ffb3ad59; }
  .tk__track { display: flex; width: max-content; animation: tk 40s linear infinite; }
