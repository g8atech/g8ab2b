---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE, SEDI, FAQ, GOOGLE, waLink, telLink } from '../data/site';
import GoogleReviews from '../components/blocks/GoogleReviews.astro';
import robotHero from '../assets/robot-hero.png';
import mark from '../assets/g8a-mark.png';
import logoWhite from '../assets/logo-g8a-bianco.png';
import fondatori from '../assets/fondatori.png';
import milani from '../assets/milani.jpg';
import testa from '../assets/testa.jpg';
import PressBar from '../components/blocks/PressBar.astro';
import Rassegna from '../components/blocks/Rassegna.astro';


const canone = ['Computer nuovi', 'Server e backup', 'Stampanti e toner', 'Assistenza tecnica', 'Monitoraggio continuo', 'Sostituzione guasti'];

const include = [
  { icon: 'pc', t: 'Computer nuovi, su misura', d: 'Configurati per il tuo lavoro, con i tuoi programmi e i tuoi dati già pronti.', href: '/noleggio-computer' },
  { icon: 'server', t: 'Server e backup automatici', d: 'I dati aziendali al sicuro, con copie controllate ogni giorno.', href: '/noleggio-backup' },
  { icon: 'printer', t: 'Stampanti con toner inclusi', d: 'Multifunzione per l\'ufficio, manutenzione e consumabili compresi.', href: '/noleggio-stampanti' },
  { icon: 'wrench', t: 'Assistenza da remoto e in sede', d: 'Un solo numero, su telefono e WhatsApp. Nessun costo a chiamata.' },
  { icon: 'activity', t: 'Monitoraggio continuo', d: 'Vediamo un disco che cede o un backup saltato prima che diventi un blocco.', href: '/rmm' },
  { icon: 'refresh', t: 'Sostituzione e aggiornamento', d: 'Se una macchina si guasta o invecchia, la cambiamo noi.' },
];

const prima = ['Spendi migliaia di euro subito per i computer', 'Ogni guasto è una fattura del tecnico', 'Backup su una chiavetta, se qualcuno se ne ricorda', 'Tre o quattro fornitori, nessuno responsabile', 'Il titolare fa il tecnico dell\'ufficio'];
const dopo = ['Nessun investimento iniziale: un canone mensile', 'Assistenza e riparazioni già comprese', 'Backup automatici e controllati ogni giorno', 'Un solo partner e un solo numero per tutto', 'Tu lavori, all\'informatica pensiamo noi'];

const settori = [
  { id: 'commercialisti', icon: 'briefcase', t: 'Commercialisti e consulenti', claim: "Archivi dei clienti al sicuro e scadenze che non aspettano un PC lento.",
    kit: [['pc', 'Un PC veloce per ogni postazione'], ['server', 'Server o NAS con backup per gli archivi clienti'], ['printer', 'Multifunzione per stampare e scansionare i documenti'], ['shieldok', 'Firewall e protezione dei dati, in regola con il GDPR']] },
  { id: 'immobiliari', icon: 'home', t: 'Agenzie immobiliari', claim: 'Annunci, foto e contratti sempre a portata, in ufficio e in giro.',
    kit: [['laptop', 'Notebook per gli agenti che lavorano fuori'], ['server', 'NAS per foto, planimetrie e contratti'], ['printer', 'Stampante a colori per vetrine e annunci'], ['wifi', 'Fibra e Wi‑Fi veloce, anche per i clienti']] },
  { id: 'medici', icon: 'medical', t: 'Studi medici e dentistici', claim: 'Agenda, cartelle e radiografie che devono esserci, sempre.',
    kit: [['pc', 'PC in reception e negli studi'], ['server', 'Server con backup per cartelle e immagini'], ['shieldok', 'Protezione dei dati sanitari dei pazienti'], ['printer', 'Stampanti per referti, ricette e fatture']] },
  { id: 'tecnici', icon: 'ruler', t: 'Studi tecnici', claim: 'Architetti, ingegneri e geometri: progetti pesanti, tempi stretti.',
    kit: [['pc', 'Workstation potenti per CAD e rendering'], ['server', 'NAS per progetti e tavole condivise'], ['printer', 'Multifunzione per tavole e documenti'], ['refresh', 'Backup automatici dei progetti, ogni giorno']] },
  { id: 'produttive', icon: 'factory', t: 'Aziende produttive', claim: "Ufficio e reparto collegati, perché un fermo costa produzione.",
    kit: [['pc', 'PC per uffici e postazioni di reparto'], ['wifi', 'Rete cablata e Wi‑Fi anche nel capannone'], ['printer', 'Stampanti di etichette e multifunzione'], ['zap', 'Server protetti da blackout e sbalzi di corrente']] },
  { id: 'negozi', icon: 'store', t: 'Negozi e attività', claim: 'Cassa, ordini e clienti: quando il PC si ferma, si ferma il negozio.',
    kit: [['pc', 'PC per la cassa e il gestionale'], ['printer', 'Stampanti per ricevute, etichette e documenti'], ['wifi', 'Fibra e Wi‑Fi stabili'], ['bot', 'Assistente AI su WhatsApp per rispondere ai clienti']] },
  { id: 'pmi', icon: 'building', t: 'PMI e uffici', claim: "Da poche a decine di postazioni: un solo partner per tutta l'informatica.",
    kit: [['pc', 'PC e notebook per tutto il personale'], ['server', 'Server, NAS e backup automatici'], ['printer', 'Multifunzione con toner inclusi'], ['wifi', 'Rete, firewall, fibra e centralino']] },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Noleggio Assistito',
  serviceType: 'Noleggio computer e assistenza informatica per aziende',
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: ['Provincia di Varese', 'Città metropolitana di Milano', 'Provincia di Lecco'],
  description: 'Computer, server, stampanti e assistenza tecnica in un unico canone mensile, con monitoraggio e sostituzione inclusi.',
};
---
<Base
  title="Noleggio Assistito: computer e assistenza IT in un canone | G8A Technology"
  description="Il Noleggio Assistito G8A: computer, server, stampanti e assistenza tecnica in un unico canone mensile, per le aziende tra Varese, Milano e Lecco. Nessun investimento iniziale, nessun vincolo."
  jsonLd={[serviceLd, faqLd]}
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__dots" aria-hidden="true"></div>
    <div class="wrap hero__row">
      <div class="hero__copy">
        <span class="hero__tag"><Image src={mark} alt="" height={22} densities={[1, 2]} loading="eager" />Noleggio Assistito G8A</span>
        <h1 class="h hero__h1">Tutta l'informatica della tua azienda. <span class="red hero__sweep" data-text="Un canone.">Un canone.</span> Zero pensieri.</h1>
        <p class="lead hero__lead">Computer, server, stampanti e assistenza tecnica in un unico canone mensile. Niente investimento iniziale, niente tecnico a chiamata: quando qualcosa si ferma, ci siamo noi.</p>
        <div class="hero__actions">
          <a class="btn btn--red" href={telLink}><Icon name="phone" />Chiama {SITE.phone}</a>
          <a class="btn btn--wa" href={waLink('Ciao, vorrei sapere come funziona il Noleggio Assistito per la mia azienda.')}><Icon name="wa" />Scrivici su WhatsApp</a>
        </div>
        <p class="hero__links"><a href="#come-funziona">Come funziona</a><span aria-hidden="true">·</span><a href="#quanto-costa">Quanto costa</a><span aria-hidden="true">·</span><span>Ti risponde una persona, non un call center</span></p>
      </div>
      <div class="hero__press"><PressBar row label="Ne hanno parlato" /></div>

      <div class="hero__visual" data-tilt>
        <div class="stage" aria-hidden="true">
          <span class="stage__glow"></span>
          <span class="stage__ring"></span>
          <span class="stage__ring stage__ring--2"></span>
          <span class="stage__mark"><Image src={mark} alt="" width={520} densities={[1, 2]} loading="eager" /></span>
          <span class="stage__floor"></span>
          {Array.from({ length: 14 }, (_, i) => <i class="spark" style={`--x:${(i * 37) % 100}%;--t:${3 + (i % 5) * 0.7}s;--dl:${(i * 0.43) % 4}s;--s:${3 + (i % 3) * 2}px`}></i>)}
        </div>
        <div class="robots">
          <div class="robots__fx"><Image class="robots__img" src={robotHero} alt="Giuseppe e Antonio Arrigo, fondatori di G8A, in armatura robotica" widths={[640, 1152]} sizes="(max-width: 900px) 100vw, 620px" loading="eager" fetchpriority="high" /></div>
          <span class="robots__shine" aria-hidden="true" style={`--src:url(${robotHero.src})`}></span>
        </div>
        <span class="chip-float chip-float--a" aria-hidden="true"><span class="live"></span>Monitoraggio continuo</span>
        <span class="chip-float chip-float--b" aria-hidden="true"><Icon name="check" size={14} width={3.2} />Sostituzione inclusa</span>
        <span class="chip-float chip-float--c" aria-hidden="true"><strong>1 canone</strong> · 0 pensieri</span>
      </div>
    </div>
  </section>

  <!-- NASTRO -->
  <div class="tk" aria-hidden="true">
    <div class="tk__track">{[...canone, 'Nessun vincolo', ...canone, 'Nessun vincolo'].map((t) => <span>{t}</span>)}</div>
  </div>

  <!-- COSA INCLUDE -->
  <section class="section" id="include">
    <div class="wrap">
      <div class="head" data-reveal>
        <span class="kicker">Cosa include</span>
        <h2 class="h h2">Un canone. <span class="red">Dentro c'è tutto.</span></h2>
        <p class="lead">Non compri le macchine e non paghi gli interventi. Noi installiamo, controlliamo, aggiorniamo e sostituiamo.</p>
      </div>
      <div class="inc">
        {include.map((x, i) => {
          const Tag = x.href ? 'a' : 'div';
          return (
          <Tag class="inc__card glow" href={x.href} data-reveal style={`--d:${(i % 3) * 0.08}s`}>
            <span class="inc__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="inc__ic"><Icon name={x.icon} size={28} stroke="#fff" width={1.9} /></span>
            <h3>{x.t}</h3>
            <p>{x.d}</p>
            {x.href && <span class="inc__go">Scopri di più →</span>}
          </Tag>
          );
        })}
      </div>
    </div>
  </section>

  <!-- PRIMA / DOPO -->
  <section class="section section--ink vs">
    <div class="vs__glow" aria-hidden="true"></div>
    <div class="wrap">
      <div class="head" data-reveal>
        <span class="kicker">Prima e dopo</span>
        <h2 class="h h2">Comprare e chiamare il tecnico, <span class="red">o farsi gestire?</span></h2>
      </div>
      <div class="vs__grid">
        <div class="vs__col" data-reveal>
          <p class="vs__h">Senza G8A</p>
          <ul>{prima.map((p) => <li><span class="vs__x"><Icon name="x" size={14} width={3} /></span>{p}</li>)}</ul>
        </div>
        <div class="vs__col vs__col--g8a" data-reveal style="--d:.15s">
          <p class="vs__h"><Image src={logoWhite} alt="" height={30} densities={[1, 2]} />Con il Noleggio Assistito</p>
          <ul>{dopo.map((p) => <li><span class="vs__ok"><Icon name="check" size={14} width={3.2} /></span>{p}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- NUMERI -->
  <section class="nums">
    <ul class="wrap stats" data-reveal>
      <li><span class="stats__n" data-count="500" data-post="+">500+</span><span class="stats__l">aziende e professionisti seguiti</span></li>
      <li><span class="stats__n" data-count="15" data-pre="~" data-post=" anni">~15 anni</span><span class="stats__l">di informatica per le imprese</span></li>
      <li><span class="stats__n" data-count="6" data-post=" sedi">6 sedi</span><span class="stats__l">tra Varese, Milano e Lecco</span></li>
      <li><span class="stats__n" data-count="30" data-post=" gg">30 gg</span><span class="stats__l">di garanzia soddisfatto o rimborsato</span></li>
    </ul>
  </section>

  <!-- COME FUNZIONA -->
  <section class="section section--paper" id="come-funziona">
    <div class="wrap">
      <div class="head" data-reveal>
        <span class="kicker">Come funziona</span>
        <h2 class="h h2">Operativi in <span class="red">1–4 giorni.</span> Senza fermare l'ufficio.</h2>
      </div>
      <div class="line" aria-hidden="true"></div>
      <ol class="steps">
        <li data-reveal><span class="steps__n">01</span><h3>Ci scrivi o ci chiami</h3><p>Ti risponde subito una persona del team, su WhatsApp o al telefono.</p></li>
        <li data-reveal style="--d:.1s"><span class="steps__n">02</span><h3>Analisi in sede</h3><p>Un tecnico vede computer, rete, stampanti e backup e ti propone il canone.</p></li>
        <li data-reveal style="--d:.2s"><span class="steps__n">03</span><h3>Installazione chiavi in mano</h3><p>Computer configurati su misura e dati migrati, di solito in 1–4 giorni lavorativi.</p></li>
        <li data-reveal style="--d:.3s"><span class="steps__n">04</span><h3>Ci pensiamo noi</h3><p>Monitoraggio, aggiornamenti e sostituzioni inclusi, per tutta la durata.</p></li>
      </ol>
    </div>
  </section>

  <!-- PER CHI -->
  <section class="section" id="settori">
    <div class="wrap">
      <div class="head" data-reveal>
        <span class="kicker">Per chi è</span>
        <h2 class="h h2">Il Noleggio Assistito, <span class="red">su misura per il tuo lavoro</span></h2>
        <p class="lead">Scegli la tua attività e guarda cosa mettiamo nel canone.</p>
      </div>
      <div class="sect" data-reveal>
        <div class="sect__tabs" role="tablist" aria-label="Settori">
          {settori.map((x, i) => (
            <button class="sect__tab" role="tab" type="button" id={`tab-${x.id}`} aria-controls={`pan-${x.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <Icon name={x.icon} size={22} width={1.8} /><span>{x.t}</span>
            </button>
          ))}
        </div>
        <div class="sect__panels">
          {settori.map((x, i) => (
            <div class="sect__panel" role="tabpanel" id={`pan-${x.id}`} aria-labelledby={`tab-${x.id}`} hidden={i !== 0}>
              <span class="sect__ic"><Icon name={x.icon} size={30} stroke="#fff" width={1.8} /></span>
              <h3 class="h sect__h">{x.t}</h3>
              <p class="sect__claim">{x.claim}</p>
              <ul class="sect__kit">
                {x.kit.map(([ic, txt], k) => <li style={`--k:${k}`}><span class="sect__kic"><Icon name={ic} size={20} stroke="#e30613" width={1.9} /></span>{txt}</li>)}
              </ul>
              <p class="sect__plus"><Icon name="check" size={16} width={3} />Sempre inclusi: assistenza, monitoraggio continuo e sostituzione dei guasti</p>
              <a class="btn btn--red" href={waLink(`Ciao, ho un'attività nel settore "${x.t}" e vorrei sapere come funziona il Noleggio Assistito.`)}><Icon name="wa" />Chiedi il canone per {x.t.toLowerCase()}</a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- QUANTO COSTA -->
  <section class="section section--paper" id="quanto-costa">
    <div class="wrap">
      <div class="price" data-reveal>
        <div class="price__mark" aria-hidden="true"><Image src={mark} alt="" width={420} densities={[1, 2]} /></div>
        <div class="price__copy">
          <span class="kicker kicker--w">Quanto costa</span>
          <h2 class="h price__h">Un prezzo fisso al mese, costruito sulla tua azienda</h2>
          <p class="price__lead">Il canone dipende da quante postazioni hai e da cosa vuoi includere. Dopo l'analisi in sede ricevi una cifra chiara, senza sorprese.</p>
          <div class="hero__actions">
            <a class="btn btn--white" href={waLink('Ciao, vorrei un preventivo per il Noleggio Assistito. In azienda abbiamo ... postazioni.')}><Icon name="wa" />Chiedi il tuo canone</a>
            <a class="btn btn--line-w" href={telLink}><Icon name="phone" />{SITE.phone}</a>
          </div>
        </div>
        <ul class="price__list">
          <li><strong>Nessun anticipo</strong><span>niente investimento iniziale</span></li>
          <li><strong>Nessun vincolo</strong><span>disdetta libera</span></li>
          <li><strong>30 giorni</strong><span>soddisfatto o rimborsato</span></li>
          <li><strong>Tutto incluso</strong><span>assistenza, monitoraggio, sostituzioni</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- CLIENTI -->
  <section class="section">
    <div class="wrap">
      <div class="head" data-reveal>
        <span class="kicker">Dicono di noi</span>
        <h2 class="h h2">Oltre 500 aziende <span class="red">si sono riprese il loro tempo</span></h2>
      </div>
      <div class="quotes">
        <figure data-reveal>
          <div class="stars" role="img" aria-label="5 stelle su 5">★★★★★</div>
          <blockquote>«La loro formula di noleggio assistito ci ha permesso di avere accesso alle migliori tecnologie senza dover sostenere un investimento iniziale eccessivo.»</blockquote>
          <figcaption><Image src={milani} alt="Marco Milani" width={52} height={52} densities={[1, 2]} /><span><strong>Marco Milani</strong><br />Titolare, Protalga Srl</span></figcaption>
        </figure>
        <figure data-reveal style="--d:.1s">
          <div class="stars" role="img" aria-label="5 stelle su 5">★★★★★</div>
          <blockquote>«Avevo bisogno di un computer per CAD e di un server per i miei dati aziendali e loro mi hanno aiutato a trovare la soluzione perfetta per le mie esigenze.»</blockquote>
          <figcaption><Image src={testa} alt="Gabriele Testa" width={52} height={52} densities={[1, 2]} /><span><strong>Geom. Gabriele Testa</strong><br />Titolare, Dream House Group Srl</span></figcaption>
        </figure>
        <figure data-reveal style="--d:.2s">
          <div class="stars" role="img" aria-label="5 stelle su 5">★★★★★</div>
          <blockquote>«Tutti molto presenti ed organizzati, sempre pronti ad intervenire in qualsiasi momento risolvendo qualsiasi problema.»</blockquote>
          <figcaption><span class="avatar" aria-hidden="true">AV</span><span><strong>Dott.ssa Antonella Vallerini</strong><br />Consulente del lavoro, Gallarate</span></figcaption>
        </figure>
      </div>
      <a class="b-more" href="/testimonianze-casistudio">Leggi i casi studio: server ripristinato in 40 minuti, centralino in 1 ora →</a>
    </div>
  </section>

  <GoogleReviews paper />
  <Rassegna />

  <!-- CHI SIAMO -->
  <section class="section section--ink" id="chi-siamo">
    <div class="wrap about">
      <div class="about__img" data-reveal><Image src={fondatori} alt="Giuseppe e Antonio Arrigo, fondatori di G8A Technology" widths={[480, 620]} sizes="(max-width: 900px) 90vw, 480px" /></div>
      <div data-reveal style="--d:.12s">
        <span class="kicker">Chi siamo</span>
        <h2 class="h h2" style="margin-top:.8rem">Due fratelli che hanno <span class="red">inventato un metodo</span></h2>
        <p class="lead" style="margin-top:1.2rem">Giuseppe e Antonio Arrigo hanno fondato G8A circa quindici anni fa. Hanno ideato il Noleggio Assistito per dare alle piccole e medie imprese un reparto IT vero, senza doverlo assumere. Oggi G8A ha sei sedi in Lombardia e tecnici interni.</p>
        <div class="sedi">{SEDI.map((s) => { const T = s.negozio ? 'a' : 'span'; return <T class:list={['sede', { 'sede--hq': s.operativa }]} href={s.negozio ? `/store/${s.negozio.slug}` : undefined}><strong>{s.city}</strong>{s.operativa ? 'Sede operativa' : s.address}</T>; })}</div>
      </div>
    </div>
  </section>

  <!-- OLTRE -->
  <section class="section" id="oltre">
    <div class="wrap">
      <div class="head" data-reveal>
        <span class="kicker">E in più</span>
        <h2 class="h h2">Quando serve, <span class="red">c'è anche questo</span></h2>
      </div>
      <div class="more">
        <a class="more__card glow" data-reveal href="https://www.fibrahero.it"><Icon name="wifi" size={28} stroke="#e30613" width={1.8} /><h3>Fibra e centralino</h3><p>Con FibraHero, G8A è il tuo operatore: connessione e telefono con lo stesso supporto.</p><span>fibrahero.it →</span></a>
        <div class="more__card glow" data-reveal style="--d:.08s"><Icon name="shieldok" size={28} stroke="#e30613" width={1.8} /><h3>Sicurezza informatica</h3><p>Firewall, antivirus gestito e protezione dai ransomware, anche sui computer che hai già.</p></div>
        <div class="more__card glow" data-reveal style="--d:.16s"><Icon name="bot" size={28} stroke="#e30613" width={1.8} /><h3>AI per aziende</h3><p>Formazione per titolari e team e assistenti AI su WhatsApp per i tuoi clienti.</p></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--paper">
    <div class="wrap faq">
      <span class="kicker">Domande frequenti</span>
      <h2 class="h h2" style="margin-top:.8rem">Tutto sul Noleggio Assistito</h2>
      {FAQ.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="cta__mark" aria-hidden="true"><Image src={mark} alt="" width={560} densities={[1, 2]} /></div>
    <div class="wrap cta__row">
      <Image src={logoWhite} alt="G8A Technology" height={70} densities={[1, 2]} class="cta__logo" />
      <h2 class="h cta__h">Smetti di fare il tecnico. Chiamaci.</h2>
      <p class="cta__lead">Raccontaci com'è il tuo ufficio: in una telefonata capiamo se il Noleggio Assistito fa per te.</p>
      <div class="hero__actions cta__actions">
        <a class="btn btn--white" href={telLink}><Icon name="phone" />Chiama {SITE.phone}</a>
        <a class="btn btn--wa" href={waLink('Ciao, vi scrivo dal sito g8a.it, vorrei parlare con un tecnico.')}><Icon name="wa" />Scrivici su WhatsApp</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Schede dei settori: clic, frecce e Home/Fine come nelle tab standard.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.sect__tab')];
  const select = (t: HTMLButtonElement, focus = false) => {
    for (const x of tabs) {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      const pan = document.getElementById(x.getAttribute('aria-controls')!);
      if (pan) pan.hidden = !on;
    }
    if (focus) t.focus();
    t.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const k = e.key;
      const n = k === 'ArrowDown' || k === 'ArrowRight' ? i + 1 : k === 'ArrowUp' || k === 'ArrowLeft' ? i - 1 : k === 'Home' ? 0 : k === 'End' ? tabs.length - 1 : null;
      if (n === null) return;
      e.preventDefault();
      select(tabs[(n + tabs.length) % tabs.length], true);
    });
  });
</script>

<style>
