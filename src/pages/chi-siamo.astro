---
// Chi siamo: il gruppo G8A. Apertura con i fondatori in armatura robotica, storia a tappe,
// numeri, i brand con i loro siti, la rete delle sedi (mappa animata) e, per ogni sede,
// i collegamenti a tutte le pagine del gruppo. Solo fatti veri: niente date o numeri inventati.
// Le animazioni sono solo decorative: il testo è tutto nell'HTML; con "riduci movimento" resta fermo.
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Rassegna from '../components/blocks/Rassegna.astro';
import InTv from '../components/blocks/InTv.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/blocks/Cta.astro';
import CircuitCanvas from '../components/CircuitCanvas.astro';
import robotHero from '../assets/robot-hero.png';
import robotCoppia from '../assets/robot-coppia.jpg';
import mark from '../assets/g8a-mark.png';
import g8aLogo from '../assets/logo-g8a.png';
import g8astore from '../assets/brand/g8astore.png';
import riparohero from '../assets/brand/riparohero.png';
import tonerhero from '../assets/brand/tonerhero.png';
import fibrahero from '../assets/brand/fibrahero.png';
import superpmi from '../assets/brand/superpmi.png';
import { SITE, SEDI, GRUPPO, GOOGLE, FONDATORI, storeUrl, waLink, telLink } from '../data/site';
import { CITTA } from '../data/citta';
import { STAMPA } from '../data/stampa';

const shineMask = await getImage({ src: robotHero, format: 'webp', width: 800 });
const LOGHI: Record<string, ImageMetadata> = { g8astore, riparohero, tonerhero, fibrahero, superpmi };
const wa = 'Ciao, vi scrivo dalla pagina Chi siamo di g8a.it: vorrei parlare con voi della mia azienda.';
const negozi = SEDI.filter((s) => s.negozio);
const operativa = SEDI.find((s) => s.operativa)!;
const conPagina = (slug: string) => CITTA.some((c) => c.slug === slug);
const rh = GRUPPO.find((g) => g.key === 'riparohero')!;
const th = GRUPPO.find((g) => g.key === 'tonerhero')!;
const voto = GOOGLE.voto.toLocaleString('it-IT', { minimumFractionDigits: 1 });

// Mappa delle sedi: coordinate reali proiettate su un riquadro 800×480 (lon 8,55–9,50; lat 45,50–45,90).
const proj = (lat: number, lon: number) => ({ x: Math.round(((lon - 8.55) / 0.95) * 640 + 60), y: Math.round(((45.9 - lat) / 0.4) * 400 + 40) });
const NODI = [
  { city: 'Solbiate Arno', ...proj(45.717, 8.815), lab: 'r', hq: true },
  { city: 'Jerago con Orago', ...proj(45.707, 8.796), lab: 'l' },
  { city: 'Gallarate', ...proj(45.66, 8.792), lab: 'l' },
  { city: 'Busto Arsizio', ...proj(45.611, 8.851), lab: 'r' },
  { city: 'Bollate', ...proj(45.546, 9.118), lab: 'r' },
  { city: 'Lecco', ...proj(45.856, 9.397), lab: 'r' },
];
const hub = NODI[0];
const rami = NODI.slice(1).map((n) => {
  const mx = (hub.x + n.x) / 2, my = (hub.y + n.y) / 2 - Math.abs(n.x - hub.x) * 0.18 - 10;
  return { ...n, d: `M${hub.x},${hub.y} Q${Math.round(mx)},${Math.round(my)} ${n.x},${n.y}` };
});

const TAPPE = [
  { k: "L'inizio", t: 'Una ditta individuale in provincia di Varese', d: 'Giuseppe e Antonio partono da soli, da un garage, con tanta assistenza tecnica fatta di persona. Vedono ogni giorno lo stesso problema: le aziende comprano computer e poi restano sole quando qualcosa si rompe.' },
  { k: 'Il metodo', t: 'Nasce il Noleggio Assistito', d: 'Computer, server, stampanti, backup e assistenza in un unico canone mensile, senza vincolo di durata. Le macchine le controlliamo noi e, se si guastano, le sostituiamo noi.' },
  { k: 'Le sedi', t: 'Cinque negozi e una sede operativa', d: 'Gallarate, Busto Arsizio, Bollate, Jerago con Orago e Lecco, più la sede operativa di Solbiate Arno: tecnici interni vicini alle aziende e alle famiglie che seguiamo.' },
  { k: 'Il gruppo', t: 'Un brand per ogni mestiere', d: 'Dal metodo nascono G8A Store, RiparoHero, TonerHero, FibraHero e SuperPMI: siti e specialità diverse, stesse persone e stesse sedi.' },
  { k: 'Oggi', t: 'Ne parlano giornali e TV', d: `Fortune Italia, Economy, Corriere dell'Economia, VareseNews e PMI Stories su Value 24 hanno raccontato il Noleggio Assistito: ${STAMPA.length} uscite in rassegna.` },
];

const title = 'Chi siamo: il gruppo G8A e i suoi brand | G8A Technology';
const description = 'G8A Technology e il suo gruppo: Noleggio Assistito per le aziende, negozi G8A Store, RiparoHero, TonerHero, FibraHero e SuperPMI. Fondata da Giuseppe e Antonio Arrigo.';
const BASE = SITE.url;
const aboutLd = {
  '@context': 'https://schema.org', '@type': 'AboutPage', name: 'Chi siamo: il gruppo G8A', url: `${BASE}/chi-siamo`, description, inLanguage: 'it-IT',
  mainEntity: { '@id': `${BASE}/#organization` }, about: { '@id': `${BASE}/#organization` },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${BASE}${shineMask.src}`, caption: 'Giuseppe e Antonio Arrigo, fondatori di G8A, in armatura robotica' },
};
const brandsLd = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'I brand del gruppo G8A',
  itemListElement: [
    { '@type': 'ListItem', position: 1, item: { '@type': 'Organization', name: SITE.name, url: BASE, description: 'Noleggio Assistito e assistenza informatica per le aziende' } },
    ...GRUPPO.map((g, i) => ({ '@type': 'ListItem', position: i + 2, item: { '@type': 'Organization', name: g.name, url: g.url, description: g.desc, parentOrganization: { '@id': `${BASE}/#organization` } } })),
  ],
};
const crumbsLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${BASE}/` },
    { '@type': 'ListItem', position: 2, name: 'Chi siamo', item: `${BASE}/chi-siamo` },
  ],
};
---
<Base title={title} description={description} jsonLd={[aboutLd, brandsLd, crumbsLd]}>
  <!-- APERTURA -->
  <section class="csh">
    <CircuitCanvas />
    <div class="wrap csh__row">
      <div class="csh__copy">
        <ol class="b-crumbs csh__crumbs" aria-label="Percorso"><li><a href="/">Home</a></li><li aria-current="page">Chi siamo</li></ol>
        <h1 class="h csh__h1"><span class="kicker csh__tag">Chi siamo · il gruppo G8A</span> Due fratelli, <span class="red">un gruppo di supereroi della tecnologia</span></h1>
        <p class="lead csh__lead">G8A è nata circa quindici anni fa da un'idea di Giuseppe e Antonio Arrigo: dare alle piccole e medie imprese un reparto informatico vero, senza doverlo assumere. Da lì è cresciuto un gruppo che segue aziende, negozi e famiglie tra Varese, Milano e Lecco.</p>
        <div class="b-actions csh__actions">
          <a class="btn btn--red" href={telLink}><Icon name="phone" />Chiama {SITE.phone}</a>
          <a class="btn btn--wa" href={waLink(wa)}><Icon name="wa" />Scrivici su WhatsApp</a>
        </div>
        <p class="csh__jump"><a href="#brand">I brand</a><span aria-hidden="true">·</span><a href="#storia">La storia</a><span aria-hidden="true">·</span><a href="#sedi">Le sedi</a><span aria-hidden="true">·</span><a href="#fondatori">I fondatori</a></p>
      </div>
      <div class="csh__visual" data-tilt>
        <div class="stage" aria-hidden="true">
          <span class="stage__glow"></span>
          <span class="stage__ring"></span>
          <span class="stage__ring stage__ring--2"></span>
          <span class="stage__mark"><Image src={mark} alt="" width={520} densities={[1, 2]} loading="eager" /></span>
          <span class="stage__floor"></span>
          {Array.from({ length: 16 }, (_, i) => <i class="spark" style={`--x:${(i * 37) % 100}%;--t:${3 + (i % 5) * 0.7}s;--dl:${(i * 0.43) % 4}s;--s:${3 + (i % 3) * 2}px`}></i>)}
        </div>
        <div class="robots">
          <div class="robots__fx"><Image class="robots__img" src={robotHero} alt="Giuseppe e Antonio Arrigo, fondatori di G8A, in armatura robotica" widths={[480, 800, 1152]} sizes="(max-width: 900px) 100vw, 640px" loading="eager" fetchpriority="high" /></div>
          <span class="robots__shine" aria-hidden="true" style={`--src:url(${shineMask.src})`}></span>
        </div>
        <ul class="orbit" aria-hidden="true">
          {GRUPPO.map((g, i) => <li style={`--i:${i};--n:${GRUPPO.length}`}><span><Image src={LOGHI[g.key]} alt="" height={46} densities={[1, 2]} loading="eager" /></span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- NASTRO DEI BRAND -->
  <div class="tkb" aria-hidden="true">
    <div class="tkb__track">{[0, 1].map(() => <>{['G8A Technology', ...GRUPPO.map((g) => g.name)].map((n) => <span>{n}</span>)}</>)}</div>
  </div>

  <!-- NUMERI -->
  <section class="section cs-num">
    <div class="wrap">
      <ul class="cs-stats">
        <li data-reveal><span class="cs-stats__n" data-count="15" data-pre="~">~15</span><span class="cs-stats__l">anni di informatica per le imprese</span></li>
        <li data-reveal style="--d:.08s"><span class="cs-stats__n" data-count="500" data-post="+">500+</span><span class="cs-stats__l">aziende e professionisti che si sono affidati a noi</span></li>
        <li data-reveal style="--d:.16s"><span class="cs-stats__n" data-count="6">6</span><span class="cs-stats__l">brand, sei siti, una sola squadra</span></li>
        <li data-reveal style="--d:.24s"><span class="cs-stats__n">{voto}★</span><span class="cs-stats__l">su Google, {GOOGLE.recensioni} recensioni della sede</span></li>
      </ul>
    </div>
  </section>

  <!-- BRAND -->
  <section class="section section--ink cs-brand-sec" id="brand">
    <div class="cs-grid-bg" aria-hidden="true"></div>
    <div class="wrap">
      <div class="b-head b-head--center" data-reveal>
        <span class="kicker">I brand del gruppo</span>
        <h2 class="h h2">Sei siti, <span class="red">una sola squadra</span></h2>
        <p class="lead">Ogni brand si occupa di una cosa precisa. Se ti serve altro, ti passiamo al collega giusto, senza ripartire da zero.</p>
      </div>
      <ul class="cs-brands">
        <li class="cs-brands__main" data-reveal>
          <a href="/" class="cs-brand cs-brand--main">
            <span class="cs-logo"><Image src={g8aLogo} alt="G8A Technology" height={110} densities={[1, 2]} /></span>
            <span class="cs-body"><strong>G8A Technology</strong>
            <span class="cs-what">Noleggio Assistito e assistenza informatica per le aziende</span>
            <span class="cs-desc">Computer, server, stampanti, backup, monitoraggio e assistenza in un canone mensile, per studi e imprese senza un informatico interno. È il cuore del gruppo.</span>
            <span class="cs-go">www.g8a.it <i>→</i></span></span>
          </a>
        </li>
        {GRUPPO.map((g, i) => (
          <li data-reveal style={`--d:${(i + 1) * 0.06}s`}>
            <a href={g.url} class="cs-brand">
              <span class="cs-logo"><Image src={LOGHI[g.key]} alt={g.name} height={76} densities={[1, 2]} /></span>
              <span class="cs-body"><strong>{g.name}</strong>
              <span class="cs-what">{g.what}</span>
              <span class="cs-desc">{g.desc}</span>
              <span class="cs-go">{g.url.replace('https://', '')} <i>→</i></span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- STORIA -->
  <section class="section" id="storia">
    <div class="wrap">
      <div class="b-head" data-reveal>
        <span class="kicker">La nostra storia</span>
        <h2 class="h h2">Dal garage <span class="red">al Noleggio Assistito</span></h2>
      </div>
      <div class="tl" data-reveal>
        <span class="tl__line" aria-hidden="true"><span class="tl__fill"></span></span>
        <ol class="tl__list">
          {TAPPE.map((t, i) => (
            <li class="tl__step">
              <span class="tl__dot" aria-hidden="true">{i + 1}</span>
              <div class="tl__card">
                <span class="tl__k">{t.k}</span>
                <h3>{t.t}</h3>
                <p>{t.d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- FONDATORI -->
  <section class="section section--ink cs-found" id="fondatori">
    <div class="wrap cs-found__row">
      <div class="cs-found__img" data-reveal>
        <Image src={robotCoppia} alt="Giuseppe e Antonio Arrigo in armatura robotica" widths={[560, 900, 1314]} sizes="(max-width: 900px) 100vw, 640px" />
        <span class="cs-found__scan" aria-hidden="true"></span>
      </div>
      <div data-reveal style="--d:.1s">
        <span class="kicker">Le persone</span>
        <h2 class="h h2" style="margin-top:.8rem">I fondatori</h2>
        <p class="lead" style="margin-top:1rem">Seguono in prima persona la strategia del gruppo e il rapporto con le aziende clienti. Le guide pubblicate su questo sito sono verificate e firmate da loro prima di andare online.</p>
        <ul class="cs-people">
          {FONDATORI.map((f) => (
            <li id={f.slug}>
              <span class="cs-people__ic"><Icon name="briefcase" size={20} stroke="#fff" /></span>
              <div><strong>{f.nome}</strong><span>{f.ruolo}</span>{f.profili.length > 0 && <span class="cs-prof">{f.profili.map((p) => <a href={p.url} target="_blank" rel="noopener">{p.nome}</a>)}</span>}</div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- SEDI -->
  <section class="section section--paper" id="sedi">
    <div class="wrap">
      <div class="cs-map-row">
        <div class="b-head" data-reveal>
          <span class="kicker">Le sedi</span>
          <h2 class="h h2">Una rete, <span class="red">sei punti in Lombardia</span></h2>
          <p class="lead">In ogni negozio trovi G8A Store, RiparoHero e TonerHero sotto lo stesso tetto; le aziende le seguiamo dalle stesse sedi e dalla sede operativa di {operativa.city}.</p>
        </div>
        <figure class="cs-map" data-reveal style="--d:.1s">
          <svg viewBox="0 0 800 480" role="img" aria-labelledby="mappa-t">
            <title id="mappa-t">Le sedi G8A: Solbiate Arno, Jerago con Orago, Gallarate, Busto Arsizio, Bollate e Lecco</title>
            <defs>
              <radialGradient id="mg" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#ff1a1a" stop-opacity=".35" /><stop offset="1" stop-color="#ff1a1a" stop-opacity="0" /></radialGradient>
              <pattern id="dots" width="18" height="18" patternUnits="userSpaceOnUse"><circle cx="1.5" cy="1.5" r="1.2" fill="#0b0b0d" opacity=".12" /></pattern>
            </defs>
            <rect width="800" height="480" fill="url(#dots)" />
            {rami.map((r, i) => (
              <g>
                <path class="map__path" d={r.d} style={`--i:${i}`} pathLength="1" />
                <circle class="map__pulse" r="4"><animateMotion dur={`${2.6 + i * 0.4}s`} repeatCount="indefinite" path={r.d} begin={`${i * 0.5}s`} /></circle>
              </g>
            ))}
            {NODI.map((n) => (
              <g class:list={['map__node', { 'map__node--hq': n.hq }]}>
                <circle cx={n.x} cy={n.y} r="34" fill="url(#mg)" class="map__halo" />
                <circle cx={n.x} cy={n.y} r={n.hq ? 9 : 7} class="map__dot" />
                <text x={n.lab === 'r' ? n.x + 16 : n.x - 16} y={n.y + 5} text-anchor={n.lab === 'r' ? 'start' : 'end'} class="map__lab">{n.city}</text>
              </g>
            ))}
          </svg>
          <figcaption>Posizione reale delle sedi. In rosso la sede operativa di Solbiate Arno, da cui partono anche i tecnici per le aziende.</figcaption>
        </figure>
      </div>

      <div class="cs-sedi">
        {negozi.map((s, i) => {
          const slug = s.negozio!.slug;
          return (
            <article class="cs-sede" data-reveal style={`--d:${i * 0.05}s`}>
              <h3>{s.city}</h3>
              <p class="cs-addr"><Icon name="building" size={16} />{s.address}, {s.cap} {s.city} ({s.province})</p>
              <p class="cs-addr"><Icon name="phone" size={16} /><a href={`tel:${s.negozio!.phoneIntl}`}>{s.negozio!.phone}</a></p>
              <ul>
                {conPagina(slug) && <li><a href={`/assistenza-informatica/${slug}`}><b>G8A</b> Assistenza informatica aziende a {s.city}</a></li>}
                <li><a href={storeUrl(slug)}><b>G8A Store</b> PC, notebook e Mac a {s.city}</a></li>
                <li><a href={rh.negozio!(slug)}><b>RiparoHero</b> Riparazione smartphone a {s.city}</a></li>
                <li><a href={th.negozio!(slug)}><b>TonerHero</b> Toner e stampanti a {s.city}</a></li>
              </ul>
            </article>
          );
        })}
        <article class="cs-sede cs-sede--hq" data-reveal style="--d:.25s">
          <h3>{operativa.city}</h3>
          <p class="cs-addr"><Icon name="building" size={16} />{operativa.address}, {operativa.cap} {operativa.city} ({operativa.province})</p>
          <p class="cs-addr"><Icon name="phone" size={16} /><a href={telLink}>{SITE.phone}</a></p>
          <ul>
            <li>Sede operativa e legale di {SITE.company}</li>
            <li><a href="/assistenza-business">Contatti e assistenza clienti</a></li>
            <li><a href={GOOGLE.leggi} target="_blank" rel="noopener">Scheda Google e recensioni</a></li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <InTv />
  <Rassegna paper />

  <section class="section cs-legal-sec">
    <div class="wrap cs-legal" data-reveal>
      <h2 class="h" data-nosplit style="font-size:1.4rem">Dati societari</h2>
      <p>{SITE.company} · P.IVA {SITE.vat} · REA {SITE.rea} · Capitale sociale {SITE.capital} · Sede legale {SITE.legalAddress} · <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>
  </section>

  <Cta lead="Che tu sia un'azienda, un professionista o un privato, c'è una persona del gruppo pronta a risponderti." waText={wa}>Parliamo della <span class="red">tua tecnologia</span></Cta>
</Base>

<script>
  // Animazioni della pagina: apertura, linea della storia, mappa che si disegna, card che si inclinano.
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const map = document.querySelector<HTMLElement>('.cs-map');

  if (reduce) {
    map?.classList.add('is-drawn');
  } else {
    const hero = document.querySelector<HTMLElement>('.csh');
    if (hero) {
      const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
      tl.from(hero.querySelectorAll('.csh__crumbs, .csh__tag'), { y: 14, opacity: 0, duration: 0.6, stagger: 0.08 })
        .from(hero.querySelector('.csh__h1'), { y: 40, opacity: 0, duration: 1.1 }, 0.05)
        .from(hero.querySelectorAll('.csh__lead, .csh__actions, .csh__jump'), { y: 24, opacity: 0, duration: 0.8, stagger: 0.08 }, 0.35)
        .from(hero.querySelector('.robots'), { y: 70, scale: 0.9, opacity: 0, duration: 1.3 }, 0.1)
        .from(hero.querySelectorAll('.stage__ring, .stage__mark'), { scale: 0.5, opacity: 0, duration: 1.4, stagger: 0.1 }, 0)
        .from(hero.querySelectorAll('.orbit li > span'), { opacity: 0, duration: 0.8, stagger: 0.12 }, 0.8);
      gsap.to(hero.querySelector('.csh__visual'), { yPercent: -12, ease: 'none', scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true } });
    }

    // Storia: la linea si riempie e le tappe si accendono scorrendo.
    const tlSec = document.querySelector<HTMLElement>('.tl');
    if (tlSec) {
      const steps = tlSec.querySelectorAll<HTMLElement>('.tl__step');
      tlSec.style.setProperty('--fill', '0');
      steps.forEach((s) => s.classList.add('tl__step--off'));
      ScrollTrigger.create({
        trigger: tlSec, start: 'top 75%', end: 'bottom 55%', scrub: true,
        onUpdate: (st) => {
          tlSec.style.setProperty('--fill', st.progress.toFixed(3));
          steps.forEach((s, i) => s.classList.toggle('tl__step--off', st.progress < i / steps.length));
        },
      });
    }

    // Mappa: i collegamenti si disegnano quando entra a schermo.
    if (map) ScrollTrigger.create({ trigger: map, start: 'top 80%', once: true, onEnter: () => map.classList.add('is-drawn') });

    // Brand: card che si inclinano verso il cursore.
    if (fine) document.querySelectorAll<HTMLElement>('.cs-brand').forEach((el) => {
      gsap.set(el, { transformPerspective: 900 });
      const rx = gsap.quickTo(el, 'rotationX', { duration: 0.6, ease: 'power3' });
      const ry = gsap.quickTo(el, 'rotationY', { duration: 0.6, ease: 'power3' });
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        ry(((e.clientX - r.left) / r.width - 0.5) * 10);
        rx(-((e.clientY - r.top) / r.height - 0.5) * 10);
      });
      el.addEventListener('pointerleave', () => { rx(0); ry(0); });
    });
  }
</script>

<style>
  /* Apertura scura con i robot */
  .csh { position: relative; overflow: hidden; background: radial-gradient(55% 70% at 78% 40%, rgba(255, 26, 26, .28), transparent 70%), radial-gradient(40% 50% at 10% 90%, rgba(150, 29, 34, .35), transparent 70%), #0b0b0d; color: #fff; padding-block: clamp(1.2rem, 3vw, 2.5rem) clamp(2rem, 5vw, 4rem); }
  .csh::before { content: ''; position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(rgba(255, 255, 255, .09) 1px, transparent 1.2px); background-size: 22px 22px; -webkit-mask-image: radial-gradient(70% 80% at 70% 40%, #000, transparent 80%); mask-image: radial-gradient(70% 80% at 70% 40%, #000, transparent 80%); }
  .csh__row { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
