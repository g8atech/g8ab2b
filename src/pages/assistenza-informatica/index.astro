---
// Panoramica: assistenza informatica per aziende nelle zone delle sedi G8A.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/blocks/PageHero.astro';
import Includes from '../../components/blocks/Includes.astro';
import Faq from '../../components/blocks/Faq.astro';
import Cta from '../../components/blocks/Cta.astro';
import GoogleReviews from '../../components/blocks/GoogleReviews.astro';
import { CITTA } from '../../data/citta';
import { ZONE } from '../../data/zone';
import { FAQ_BASE, faqLd, serviceLd } from '../../data/site';
const wa = "Ciao, vi scrivo dal sito g8a.it: vorrei informazioni sull'assistenza informatica per la mia azienda.";
const desc = 'Assistenza informatica per aziende nelle province di Varese, Milano e Lecco: punti G8A a Gallarate, Busto Arsizio, Bollate, Jerago con Orago e Lecco. Un canone, tutto incluso.';
const faq = FAQ_BASE;
---
<Base title="Assistenza informatica per aziende: Varese, Milano e Lecco | G8A Technology" description={desc} jsonLd={[serviceLd('Assistenza informatica per aziende', desc, '/assistenza-informatica'), faqLd(faq)]}>
  <PageHero kicker="Assistenza informatica per aziende" crumb="Assistenza informatica" waText={wa}
    lead="Computer, server, backup, stampanti e sicurezza gestiti da noi in un unico canone. Tecnici interni, assistenza da remoto e in sede, punti G8A in cinque città tra Varese, Milano e Lecco."
    chips={['Tecnici interni', 'Da remoto e in sede', '5 punti in Lombardia']}>
    <Fragment slot="title">Assistenza informatica per aziende <span class="red">vicino a te</span></Fragment>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <div class="b-head" data-reveal>
        <span class="kicker">Le zone</span>
        <h2 class="h h2">Scegli <span class="red">la tua zona</span></h2>
        <p class="lead">Ogni punto G8A segue le aziende della sua zona. Gli interventi in sede partono dalla sede operativa di Solbiate Arno.</p>
      </div>
      <div class="zz">
        {CITTA.map((c, i) => (
          <a class="zz__card glow" href={`/assistenza-informatica/${c.slug}`} data-reveal style={`--d:${(i % 3) * 0.08}s`}>
            <span class="zz__k">{c.provincia === 'MI' ? 'Milano' : c.provincia === 'LC' ? 'Lecco' : 'Varese'}</span>
            <strong>Assistenza informatica a {c.nome}</strong>
            <span>{c.comuni.slice(1, 5).join(', ')} e dintorni</span>
            <em>Vedi la zona <Icon name="check" size={13} width={3} /></em>
          </a>
        ))}
      </div>
      <div class="zz-more" data-reveal>
        <p class="zz-more__h">Seguiamo anche le aziende di</p>
        <ul class="zz-more__list">{ZONE.map((z) => <li><a href={`/assistenza-informatica/${z.slug}`}>{z.nome} <small>({z.provincia})</small></a></li>)}</ul>
      </div>
    </div>
  </section>

  <Includes paper lead="Tutto in un canone mensile del Noleggio Assistito, senza investimento iniziale." cols={3} items={[
    { icon: 'pc', t: 'Computer e postazioni', d: 'PC nuovi configurati su misura, sostituiti da noi se si guastano.', href: '/noleggio-computer' },
    { icon: 'server', t: 'Server, NAS e backup', d: 'Dati aziendali al sicuro, backup automatici anche fuori sede.', href: '/noleggio-backup' },
    { icon: 'printer', t: 'Stampanti e multifunzione', d: 'Toner e assistenza inclusi.', href: '/noleggio-stampanti' },
  ]}>Cosa <span class="red">gestiamo noi</span></Includes>

  <GoogleReviews show={3} />
  <Faq items={faq}>Domande <span class="red">frequenti</span></Faq>
  <Cta lead="Ci racconti quanti computer avete e come lavorate: ti diciamo cosa serve, senza impegno." waText={wa}>Assistenza informatica <span class="red">senza pensieri</span></Cta>
</Base>

<style>
  .zz-more { margin-top: 2.2rem; }
  .zz-more__h { font-weight: 800; }
  .zz-more__list { list-style: none; padding: 0; margin: .9rem 0 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .zz-more__list a { display: inline-block; padding: .5rem .95rem; border-radius: 999px; background: var(--paper); border: 1px solid var(--line); font-weight: 700; text-decoration: none; color: var(--ink); }
  .zz-more__list a:hover { border-color: #e30613; color: #e30613; }
  .zz-more__list small { color: var(--muted); font-weight: 600; }
  .zz { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1rem; margin-top: 2rem; }
  .zz__card { display: grid; gap: 0.35rem; padding: 1.4rem 1.5rem; border-radius: 18px; background: #fff; border: 1px solid var(--line); transition: transform 0.2s, border-color 0.2s; }
  .zz__card:hover { transform: translateY(-2px); border-color: #e30613; }
  .zz__k { font-size: 0.78rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #e30613; }
  .zz__card strong { font-size: 1.15rem; }
  .zz__card span:not(.zz__k) { color: var(--muted); font-size: 0.92rem; }
  .zz__card em { font-style: normal; font-weight: 700; margin-top: 0.4rem; display: inline-flex; align-items: center; gap: 0.35rem; }
</style>
