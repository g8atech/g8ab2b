---
// Assistenza informatica per aziende a <città>: una pagina per ogni sede G8A (SedePage)
// e una per i comuni principali intorno alle sedi (ZonaPage), ognuna con contenuti propri.
// Qui portano anche i vecchi siti per città (es. gallarate.g8a.it), vedi middleware.js.
import SedePage from '../../components/pages/SedePage.astro';
import ZonaPage from '../../components/pages/ZonaPage.astro';
import { CITTA, type Citta } from '../../data/citta';
import { ZONE, type Zona } from '../../data/zone';

export function getStaticPaths() {
  return [
    ...CITTA.map((c) => ({ params: { citta: c.slug }, props: { c } })),
    ...ZONE.map((z) => ({ params: { citta: z.slug }, props: { z } })),
  ];
}
const { c, z } = Astro.props as { c?: Citta; z?: Zona };
---
{c ? <SedePage c={c} /> : <ZonaPage z={z!} />}
