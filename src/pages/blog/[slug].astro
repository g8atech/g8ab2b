---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SideCta from '../../components/kb/SideCta.astro';
import PostCard from '../../components/kb/PostCard.astro';
import Faq from '../../components/blocks/Faq.astro';
import Cta from '../../components/blocks/Cta.astro';
import { SITE, faqLd } from '../../data/site';
import { dataIt, minuti, crumbsLd, SERVIZI } from '../../data/kb';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}
const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const toc = headings.filter((h) => h.depth === 2);
const path = `/blog/${post.id}`;
const wa = `Ciao, ho letto "${d.title}" sul vostro sito e vorrei un consiglio per la mia azienda.`;
const altri = posts.filter((p) => p.id !== post.id).sort((a, b) => Number(b.data.categoria === d.categoria) - Number(a.data.categoria === d.categoria) || +b.data.date - +a.data.date).slice(0, 3);
const ld: object[] = [
  {
    '@context': 'https://schema.org', '@type': 'BlogPosting', headline: d.title, description: d.description,
    datePublished: d.date.toISOString(), dateModified: (d.updated ?? d.date).toISOString(),
    mainEntityOfPage: `${SITE.url}${path}`, image: `${SITE.url}/og-g8a.jpg`, inLanguage: 'it-IT', articleSection: d.categoria,
    author: { '@id': `${SITE.url}/#organization` }, publisher: { '@id': `${SITE.url}/#organization` },
  },
  crumbsLd([{ name: 'Home', path: '' }, { name: 'Blog', path: '/blog' }, { name: d.title, path }]),
];
if (d.faq.length) ld.push(faqLd(d.faq));
---
<Base title={d.seoTitle ?? `${d.title} | G8A Technology`} description={d.description} jsonLd={ld} ogType="article">
  <article>
    <header class="b-hero art">
      <div class="wrap">
        <ol class="b-crumbs" aria-label="Percorso"><li><a href="/">Home</a></li><li><a href="/blog">Blog</a></li><li aria-current="page">{d.categoria}</li></ol>
        <span class="kicker">{d.categoria}</span>
        <h1 class="h b-hero__h1 art__h1" set:html={d.title.replace(/(\d+-\d+-\d+)/g, '<span style="white-space:nowrap">$1</span>')} />
        <p class="art__meta">
          <span>Di <strong>Tecnici G8A Technology</strong></span>
          <span><time datetime={d.date.toISOString()}>{dataIt(d.date)}</time></span>
          {d.updated && <span>Aggiornato il <time datetime={d.updated.toISOString()}>{dataIt(d.updated)}</time></span>}
          <span>{minuti(post.body)} min di lettura</span>
        </p>
      </div>
    </header>

    <div class="section art__sec">
      <div class="wrap art__grid">
        <div class="art__main">
          <div class="brief"><p class="brief__k"><Icon name="zap" size={16} width={2.4} />In breve</p><p>{d.inBreve}</p></div>
          {toc.length > 2 && (
            <nav class="toc toc--m" aria-label="In questo articolo"><details><summary>In questo articolo</summary><ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></details></nav>
          )}
          <div class="prose"><Content /></div>
        </div>
        <aside class="art__side">
          {toc.length > 2 && (
            <nav class="toc" aria-label="In questo articolo"><p class="toc__h">In questo articolo</p><ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>
          )}
          <SideCta servizio={d.servizio} waText={wa} />
        </aside>
      </div>
    </div>
  </article>

  {d.faq.length > 0 && <Faq items={d.faq}>Domande <span class="red">frequenti</span></Faq>}

  <section class="section">
    <div class="wrap">
      <div class="b-head"><span class="kicker">Continua a leggere</span><h2 class="h h2">Altre guide <span class="red">per la tua azienda</span></h2></div>
      <div class="rel">{altri.map((p) => <PostCard href={`/blog/${p.id}`} kicker={p.data.categoria} title={p.data.title} description={p.data.description} date={p.data.date} />)}</div>
      <a class="b-more" href="/blog">Tutti gli articoli →</a>
    </div>
  </section>

  <Cta lead={`${SERVIZI[d.servizio].frase} Raccontaci com'è il tuo ufficio e ti diciamo cosa serve, senza impegno.`} waText={wa}>Ne parliamo? <span style="color:#ff6b6b">Ti rispondiamo noi.</span></Cta>
</Base>

<script>
  // Evidenzia nell'indice laterale la sezione che si sta leggendo.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('.art__side .toc a')].map((a) => [a.hash.slice(1), a]));
  const obs = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { links.forEach((a) => a.removeAttribute('aria-current')); links.get(e.target.id)?.setAttribute('aria-current', 'true'); } }), { rootMargin: '-20% 0px -70% 0px' });
  links.forEach((_, id) => { const h = document.getElementById(id); if (h) obs.observe(h); });
</script>

<style>
  .art { padding-block: clamp(1.5rem, 3vw, 2.5rem); }
  .art__h1 { max-width: 54rem; font-size: clamp(2rem, 4vw, 3.2rem); }
  .art__meta { display: flex; flex-wrap: wrap; gap: 0.3rem 1.2rem; margin-top: 1.1rem; color: var(--muted); font-size: 0.95rem; }
  .art__meta strong { color: var(--ink); }
  .art__sec { padding-top: clamp(2rem, 4vw, 3rem); }
  .art__grid { display: grid; grid-template-columns: minmax(0, 1fr) 20rem; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .art__side { position: sticky; top: 6.5rem; display: grid; gap: 1.2rem; }
  .brief { max-width: 44rem; margin-bottom: 2rem; padding: 1.2rem 1.4rem; border-radius: 16px; background: #fff5f5; border: 1px solid #ffd4d4; font-size: 1.08rem; font-weight: 600; }
  .brief__k { display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.35rem; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--red); }
  .toc { padding: 1.2rem 1.3rem; border-radius: 16px; border: 1px solid var(--line); background: var(--paper); font-size: 0.93rem; }
  .toc__h, .toc summary { font-weight: 800; font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .toc ol { margin: 0.6rem 0 0; padding-left: 1.1rem; display: grid; gap: 0.35rem; }
  .toc a { color: var(--ink); text-decoration: none; font-weight: 600; }
  .toc a:hover, .toc a[aria-current] { color: var(--red); }
  .toc--m { display: none; margin-bottom: 1.8rem; }
  .toc--m summary { cursor: pointer; }
  .rel { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2rem; }
  @media (max-width: 1000px) {
    .art__grid { grid-template-columns: 1fr; }
    .art__side { position: static; }
    .art__side .toc { display: none; }
    .toc--m { display: block; }
    .rel { grid-template-columns: 1fr; }
  }
</style>
