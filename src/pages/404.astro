---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina non trovata | G8A Technology" description="La pagina che cerchi non esiste più.">
  <section class="b-hero">
    <div class="wrap" style="text-align:center;padding-block:3rem">
      <span class="kicker">Errore 404</span>
      <h1 class="h b-hero__h1">Questa pagina <span class="red">non c'è più</span></h1>
      <p class="lead" style="margin:1rem auto 0">Forse abbiamo rinnovato il sito. Torna alla home o scrivici: ti aiutiamo noi.</p>
      <div class="b-actions" style="justify-content:center;display:flex"><a class="btn btn--red" href="/">Torna alla home</a></div>
    </div>
  </section>
</Base>
